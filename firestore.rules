        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function hasProfile() {
      return signedIn() && userDoc(request.auth.uid) != null;
    }

    function myOrg() {
      return hasProfile() ? userDoc(request.auth.uid).data.organizationId : '';
    }

    function myRole() {
      return hasProfile() ? userDoc(request.auth.uid).data.role : '';
    }

    // `role` is retained as the primary role for old app versions; new member
    // profiles carry the complete additive grant set in `roles`.
    function rolesOf(data) {
      return data.keys().hasAll(['roles']) ? data.roles : [data.role];
    }

    function myRoles() {
      return hasProfile() ? rolesOf(userDoc(request.auth.uid).data) : [];
    }

    function validRoleSet(roles, primaryRole) {
      return roles is list
        && roles.size() > 0
        && roles.size() <= 5
        && roles[0] == primaryRole
        && roles.hasOnly(['admin','quality_manager','lab','nutritionist','viewer','trial_owner'])
        && roles.toSet().size() == roles.size()
        && (roles.size() == 1 || !roles.hasAny(['admin','trial_owner']));
    }

    function rolesMatch(a, b) {
      return rolesOf(a).hasAll(rolesOf(b))
        && rolesOf(b).hasAll(rolesOf(a));
    }

    function myStatus() {
      return hasProfile() ? userDoc(request.auth.uid).data.status : '';
    }

    function rolePermissions(role) {
      return role == 'admin' ? [
        'org.read','org.update',
        'users.read','users.create','users.update','users.disable',
        'samples.read','samples.create','samples.update',
        'lab_results.read','lab_results.create','lab_results.update',
        'qc.read','qc.write','qc.approve','qc.reject',
        'reports.read','reports.create','reports.export',
        'devices.read','devices.register','devices.update','audit.read',
        'formulations.read','formulations.create','formulations.update','reference.update'
      ] : role == 'trial_owner' ? [
        'org.read',
        'samples.read','samples.create','samples.update',
        'lab_results.read','lab_results.create','lab_results.update',
        'qc.read','qc.write',
        'reports.read','reports.create','devices.register',
        'formulations.read','formulations.create','formulations.update'
      ] : role == 'quality_manager' ? [
        'org.read','users.read',
        'samples.read','samples.create','samples.update',
        'lab_results.read','lab_results.create','lab_results.update',
        'qc.read','qc.write','qc.approve','qc.reject',
        'reports.read','reports.create','reports.export','devices.register','audit.read',
        'formulations.read','reference.update'
      ] : role == 'lab' ? [
        'org.read','users.read',
        'samples.read','samples.create','samples.update',
        'lab_results.read','lab_results.create','lab_results.update',
        'qc.read','qc.write','qc.approve','qc.reject',
        'reports.read','reports.create','reports.export','devices.register','audit.read','formulations.read','reference.update'
      ] : role == 'viewer' ? [
        'org.read','samples.read','lab_results.read','qc.read','reports.read','reports.export','devices.register',
        'formulations.read'
      ] : role == 'nutritionist' ? [
        'org.read','samples.read','lab_results.read','reports.read','devices.register',
        'formulations.read','formulations.create','formulations.update'
      ] : [];
    }

    function inOrg(orgId) {
      return myOrg() == orgId;
    }

    // An `invited`/`disabled` member can read nothing and write nothing: the
    // whole permission check is gated on the status, not only on the role.
    //
    // Trial-expiry gate: a `suspended` organization (30-day trial finished,
    // waiting for manual activation by support) locks every member out of all
    // reads and writes below, even though the member row itself is `active`.
    // The owner can still `get` the org document itself (see below) so the
    // app can show the trial-expired screen. Status flips
    // Lifecycle changes require reviewed administration; expiry itself is
    // enforced below using request.time, without a scheduled function.
    function orgUsable(orgId) {
      let org = get(/databases/$(database)/documents/organizations/$(orgId));
      let end = org.data.get('trialEndsAt', null);
      return org != null && org.data.status in ['trial', 'active']
        && (org.data.status != 'trial' || org.data.get('manuallyActivated', false) == true
          || (end is timestamp && request.time < end));
    }

    function activeInOrg(orgId) {
      let profile = signedIn() ? userDoc(request.auth.uid) : null;
      let org = get(/databases/$(database)/documents/organizations/$(orgId));
      let end = org.data.get('trialEndsAt', null);
      return profile != null && profile.data.organizationId == orgId
        && profile.data.status == 'active' && org != null
        && org.data.status in ['trial','active']
        && (org.data.status != 'trial' || org.data.get('manuallyActivated', false) == true
          || (end is timestamp && request.time < end))
        && (request.method in ['get', 'list'] || org.data.get('commandProtocol', {}).get('maintenance', false) != true);
    }

    function roleCan(perm) {
      let doc = userDoc(request.auth.uid);
      return doc == null ? false : (doc.data.role == 'admin' ? true
        : (perm in ['qc.write','lab_results.create','lab_results.update','samples.create','samples.update']
            && doc.data.role in ['quality_manager','lab','trial_owner']) ? true
        : (perm in ['qc.approve','qc.reject'] && doc.data.role in ['quality_manager','lab']) ? true
        : roleCanRoles(perm, doc.data));
    }
    function labConfigCanWrite(configType, action) {
      return roleCan(configType in ['lab_products','lab_product_analyses','lab_units']
        ? 'reference.update'
        : (configType.matches('nutrition_.*') ? 'formulations.' : 'lab_results.') + action);
    }
    function roleCanRoles(perm, data) {
      let roles = rolesOf(data);
      return roles.size() == 1 ? rolePermissionGranted(roles[0], perm) : ('admin' in roles
        || ('trial_owner' in roles && rolePermissionGranted('trial_owner', perm))
        || ('quality_manager' in roles && rolePermissionGranted('quality_manager', perm))
        || ('lab' in roles && rolePermissionGranted('lab', perm))
        || ('nutritionist' in roles && rolePermissionGranted('nutritionist', perm))
        || ('viewer' in roles && rolePermissionGranted('viewer', perm)));
    }
    function can(orgId, perm) {
      let doc = signedIn() ? userDoc(request.auth.uid) : null;
      let profile = doc != null ? doc.data : {};
      return activeInOrg(orgId) && validRoleSet(rolesOf(profile), profile.role) && roleCan(perm);
    }

    function canManage(uid) {
      return userDoc(uid) != null
        && can(userDoc(uid).data.organizationId, 'users.update');
    }

    function blocksNewCompany(uid) {
      return userDoc(uid) != null
        && userDoc(uid).data.keys().hasAll(['organizationId'])
        && userDoc(uid).data.status in ['invited','pending_activation','active'];
    }

    // Audit actions the clients may ever write. Anything else (e.g. a forged
    // `MEMBER_ACTIVATED`) is rejected: the log is append-only *and*
    // allow-listed, otherwise any active member could fake an activation entry.
    function validAuditAction(action) {
      return action in [
        'ORGANIZATION_CREATED','ORG_UPDATED',
        'MEMBER_INVITED','MEMBER_INVITE_RESENT','MEMBER_ROLE_CHANGED',
        'MEMBER_ACTIVATED','MEMBER_DISABLED','MEMBER_REMOVED','MEMBER_LEFT',
        'INVITE_CLAIMED',
        'DENIED_ENTRY',
        'SAMPLE_CREATED','SAMPLE_UPDATED','SAMPLE_DELETED',
        'QC_APPROVED','QC_REJECTED',
        'LAB_RESULT_SAVED','SYNC_CONFLICT','BACKUP_RESTORED',
        'SETTINGS_UPDATED','DEVICE_REGISTERED',
        'CUSTOM_TABLE_SAVED','CUSTOM_TABLE_DELETED','CUSTOM_ROW_RECORDED','CUSTOM_ROW_DELETED'];
    }

    // ── sync envelope invariants (plan §6.1) ─────────────────────────────
    // Every pushed document carries the envelope. `createdBy`, `createdAt`,
    // `organizationId` and `localId` are immutable after creation, and the
    // version has to increase by exactly one: that is what makes the
    // last-writer-wins + conflict detection of §9.7 verifiable server-side.
    //
    // Two known gaps, deliberately left open rather than half-closed:
    //
    //  * `createdBy` is only asserted to be a string, not to equal
    //    `request.auth.uid`. `buildRemotePayload` fills it from the local
    //    row's `created_by`, so requiring authorship would reject rows first
    //    pushed by a member other than their author. Attribution is not worth
    //    breaking sync for.
    //  * There is no `hasOnly` per collection. The real payload is *every*
    //    column of the backing table (`buildRemotePayload` ignores
    //    `mutableFields`, which is documentation-only), so a member can append
    //    an arbitrary column that `PullWorker` will mirror locally — e.g.
    //    `reportHtml` on a sample. Closing it requires making `mutableFields`
    //    authoritative first, or the allow-lists will reject legitimate
    //    pushes. Tracked as a follow-up, not a rules tweak.
    function activeOwnedDevice(orgId, deviceId) {
      let device = get(/databases/$(database)/documents/organizations/$(orgId)/devices/$(deviceId));
      return deviceId is string && deviceId != '' && device != null
        && device.data.uid == request.auth.uid
        && device.data.get('status', 'active') == 'active';
    }

    function writerDevice(orgId) {
      let id = request.resource.data.get('deviceId', '');
      let device = get(/databases/$(database)/documents/organizations/$(orgId)/devices/$(id));
      return activeOwnedDevice(orgId, id) && device.data.get('readOnly', true) == false;
    }

    function legacyDomainWritesAllowed(orgId) {
      return directBusinessLinked(orgId) && secureWriteFence(orgId, request.resource.data);
    }

    function directEnabled(orgId) {
      let org = get(/databases/$(database)/documents/organizations/$(orgId));
      let gate = org.data.get('commandProtocol', {});
      return activeInOrg(orgId) && gate.get('enabled', false) == true
        && gate.get('mode', '') == 'firestore_direct_v2'
        && gate.get('schemaVersion', 0) == 3
        && gate.get('writePolicy', '') == 'multi_authorized'
        && gate.get('maintenance', true) == false
        && gate.get('domainManifestVersion', 0) == 1
        && gate.get('globalReferencesReady', false) == true
        && gate.get('uniqueAdmissionComplete', false) == true;
    }

    function directWriter(orgId, deviceId) {
      let org = get(/databases/$(database)/documents/organizations/$(orgId));
      let device = get(/databases/$(database)/documents/organizations/$(orgId)/devices/$(deviceId));
      let profile = userDoc(request.auth.uid);
      return directEnabled(orgId)
        && validRoleSet(rolesOf(profile.data), profile.data.role) && device != null
        && device.data.uid == request.auth.uid && device.data.get('status', 'active') == 'active'
        && device.data.get('readOnly', true) == false;
    }

    // Every direct business effect is tied to the same immutable receipt,
    // event and incremented sequence; an older client cannot skip the feed.
    // A newly created small event already validates the authenticated receipt
    // through directMetadataLinked and every source image through exactEffects.
    // Require its commit timestamp here: an existing event cannot authorize a
    // later unreported write. Expanded events retain their separate proof.
    function directBusinessLinked(orgId) {
      return request.resource.data.protocol.get('effect', null) == null ? smallBusinessLinked(orgId)
        : expandedDomainLinked(orgId, request.resource.data);
    }
    function expandedDomainLinked(orgId, d) {
      return d.protocol.entityType == 'labProductAnalysis'
        || (d.protocol.get('ledgerMode', '') == 'consumption_v1' && d.protocol.entityType != 'labResult')
        ? compactChildLinked(orgId) : expandedBusinessLinked(orgId);
    }
    function smallBusinessLinked(orgId) {
      let d = request.resource.data;
      let event = getAfter(/databases/$(database)/documents/organizations/$(orgId)/changeEvents/$(('event_' + string(d.centralSequence))));
      return event.data.records.size() <= 4
        && event.data.committedAt == request.time
        && event.data.operationId == d.protocol.operationId
        && event.data.deviceId == d.deviceId
        && event.data.recordPaths.hasAny([request.path])
        && d.protocol.mode == 'firestore_direct_v2' && d.protocol.schemaVersion == 3
        && d.protocol.migrationId == get(/databases/$(database)/documents/organizations/$(orgId)).data.commandProtocol.migrationId;
    }
    function compactChildLinked(orgId) {
      let d = request.resource.data;
      let event = getAfter(/databases/$(database)/documents/organizations/$(orgId)/changeEvents/$(('event_' + string(d.centralSequence))));
      return event.data.records.size() <= 10
        && event.data.committedAt == request.time
        && event.data.operationId == d.protocol.operationId
        && event.data.deviceId == d.deviceId
        && event.data.recordPaths.hasAny([request.path])
        && d.protocol.mode == 'firestore_direct_v2' && d.protocol.schemaVersion == 3
        && d.protocol.migrationId == get(/databases/$(database)/documents/organizations/$(orgId)).data.commandProtocol.migrationId;
    }

    function expandedBusinessLinked(orgId) {
      let d = request.resource.data;
      let operation = d.protocol.operationId;
      let receipt = getAfter(/databases/$(database)/documents/organizations/$(orgId)/commandReceipts/$(operation));
      let event = getAfter(/databases/$(database)/documents/organizations/$(orgId)/changeEvents/$(('event_' + string(d.centralSequence))));
      return receipt.data.uid == request.auth.uid && receipt.data.deviceId == d.deviceId
        && receipt.data.changeSequence == d.centralSequence && receipt.data.committedAt == request.time
        && d.protocol.mode == 'firestore_direct_v2' && d.protocol.schemaVersion == 3
        && d.protocol.migrationId == receipt.data.migrationId
        && event.data.operationId == operation && event.data.recordPaths.hasAny([request.path]);
    }

    function directMetadataLinked(orgId) {
      let d = request.resource.data;
      let receipt = getAfter(/databases/$(database)/documents/organizations/$(orgId)/commandReceipts/$(d.operationId));
      return d.organizationId == orgId && receipt.data.uid == request.auth.uid
        && receipt.data.deviceId == d.deviceId && receipt.data.changeSequence == d.sequence
        && receipt.data.committedAt == request.time;
    }

    function hasEnvelope(orgId) {
      return legacyDomainWritesAllowed(orgId) && request.resource.data.organizationId == orgId
        && request.resource.data.keys().hasAll([
             'organizationId','version','createdAt','updatedAt',
             'updatedBy','createdBy','deviceId','localId'])
        && request.resource.data.version == 1
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.localId != null;
    }

    function bumped(orgId) {
      return legacyDomainWritesAllowed(orgId) && request.resource.data.version == resource.data.version + 1
        && request.resource.data.organizationId == orgId
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.localId == resource.data.localId
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.remoteId == resource.data.remoteId
        && (resource.data.get('deletedAt', null) == null || request.resource.data.get('deletedAt', null) != null);
    }

    // ── users/{uid} - the authorization source (plan §6) ─────────────────
    match /users/{uid} {

      function userPayloadOk() {
        return request.resource.data.keys().hasOnly([
                 'email','organizationId','role','roles','status','memberId','inviteKey',
                 'displayName','photoUrl','lastSeenAt','lastDeviceId',
                 'createdAt','updatedAt','version','updatedBy'])
            && request.resource.data.email is string
            && request.resource.data.email.lower() == request.auth.token.email.lower()
            && request.resource.data.organizationId is string
            && request.resource.data.organizationId.size() > 3
            && request.resource.data.role in ['admin','quality_manager','lab','nutritionist','viewer','trial_owner']
            && validRoleSet(rolesOf(request.resource.data), request.resource.data.role)
            && request.resource.data.status in ['invited','pending_activation','active']
            && request.resource.data.version == 1;
      }

      function memberAfterMatchesProfile() {
        let member = getAfter(/databases/$(database)/documents/organizations/
          $(resource.data.organizationId)/members/$(resource.data.memberId));
        return member != null
          && member.data.uid == uid
          && member.data.role == request.resource.data.role
          && rolesMatch(member.data, request.resource.data)
          && member.data.status == request.resource.data.status;
      }

      function disabledMemberAfterMatchesProfile() {
        let member = getAfter(/databases/$(database)/documents/organizations/
          $(resource.data.organizationId)/members/$(resource.data.memberId));
        return member != null && member.data.uid == uid
          && member.data.status == 'disabled'
          && member.data.role == resource.data.role
          && rolesMatch(member.data, resource.data);
      }

      // (a) claimed invitation: the invite document decides the organization,
      // the role and the member id - the client cannot choose them. The member
      // signed in (password or Google) and now waits for manager activation,
      // so the profile lands in `pending_activation`, never `active`.
      function claimedInvite() {
        let orgId = request.resource.data.organizationId;
        let invite = get(/databases/$(database)/documents/organizations/$(orgId)
                          /invites/$(request.resource.data.inviteKey));
        return request.resource.data.status == 'pending_activation'
          && invite != null
          && invite.data.email.lower() == request.auth.token.email.lower()
          && invite.data.role == request.resource.data.role
          && rolesMatch(invite.data, request.resource.data)
          && invite.data.memberId == request.resource.data.memberId;
      }

      // (b) The founder must own the organization in this atomic commit.
      // The organization create rule independently validates genesis. A trial company
      // (`status == 'trial'`) yields `trial_owner`; a full company yields
      // `admin`. A later approval action promotes trial → active / owner.
      function foundedOrganization() {
        let orgId = request.resource.data.organizationId;
        let org = getAfter(/databases/$(database)/documents/organizations/$(orgId));
        return request.resource.data.status == 'active'
          && org != null
          && org.data.ownerUid == request.auth.uid
              && ((org.data.status == 'trial'
                && request.resource.data.role == 'trial_owner'
                && rolesOf(request.resource.data) == ['trial_owner'])
              || (org.data.status == 'active'
                && request.resource.data.role == 'admin'
                && rolesOf(request.resource.data) == ['admin']));
      }

      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn() && request.auth.uid == uid
        && verifiedEmail()
        && userPayloadOk()
        && (claimedInvite() || foundedOrganization());
      allow update: if signedIn() && (
            (request.auth.uid == uid
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['displayName','photoUrl','lastSeenAt','lastDeviceId'])
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasAny(['displayName','photoUrl','lastSeenAt','lastDeviceId'])
              && request.resource.data.organizationId == resource.data.organizationId
              && request.resource.data.role == resource.data.role
              && rolesMatch(request.resource.data, resource.data)
              && request.resource.data.status == resource.data.status
              && request.resource.data.memberId == resource.data.memberId
              && request.resource.data.email == resource.data.email)
          || ((request.resource.data.status == resource.data.status
                 || (resource.data.status in ['invited','pending_activation']
                     && request.resource.data.status == 'active'))
               && canManage(uid)
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                    'role','roles','status','displayName','activatedAt','activatedBy',
                    'organizationId','updatedBy','updatedAt','version'])
               && request.resource.data.email == resource.data.email
               && request.resource.data.memberId == resource.data.memberId
               && validRoleSet(rolesOf(request.resource.data), request.resource.data.role)
               && memberAfterMatchesProfile()
               && request.resource.data.version == resource.data.version + 1
               // Activation only moves invited/pending_activation → active, and
               // only the manager path (users.update) may do it: the self
               // branch below can only ever go to `disabled`.
               && (request.resource.data.status == resource.data.status
                   || (resource.data.status in ['invited','pending_activation']
                       && request.resource.data.status == 'active'))
               // The organization binding may only be dropped (disabling a
               // member), never swapped for another organization.
               && (!request.resource.data.keys().hasAll(['organizationId'])
                     || request.resource.data.organizationId == resource.data.organizationId))
          || ( // Manager disable: an active/pending/invited profile moves to
               // `disabled` and drops the organization binding so the account
               // returns to `no_company`. Gated on `users.disable` (not the
               // `canManage`/users.update gate above), same tombstone shape
               // as the self-leave branch.
               request.auth.uid != uid
               && can(userDoc(uid).data.organizationId, 'users.disable')
               && resource.data.status in ['invited','pending_activation','active']
               && request.resource.data.status == 'disabled'
               && disabledMemberAfterMatchesProfile()
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                    'role','roles','status','displayName','activatedAt','activatedBy',
                    'organizationId','memberId','updatedBy','updatedAt','version'])
               && request.resource.data.email == resource.data.email
               && request.resource.data.role == resource.data.role
               && rolesMatch(request.resource.data, resource.data)
               && !request.resource.data.keys().hasAll(['organizationId'])
               && !request.resource.data.keys().hasAll(['memberId'])
               && request.resource.data.version == resource.data.version + 1)
          || ( // Self-service departure: the member drops their own organization
               // binding. `organizationId` may only disappear, never change.
               request.auth.uid == uid
               && resource.data.status in ['invited','pending_activation','active']
               && request.resource.data.status == 'disabled'
               && disabledMemberAfterMatchesProfile()
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                    'status','organizationId','memberId','updatedBy','updatedAt','version'])
               && !request.resource.data.keys().hasAll(['organizationId'])
               && !request.resource.data.keys().hasAll(['memberId'])
               && request.resource.data.role == resource.data.role
               && rolesMatch(request.resource.data, resource.data)
               && request.resource.data.email == resource.data.email
               && request.resource.data.updatedBy == request.auth.uid
               && request.resource.data.version == resource.data.version + 1));
      allow delete: if false;
    }

    // ── organizations ────────────────────────────────────────────────────
    match /organizations/{orgId} {

      // The organization id is derived from the owner uid, so creation is
      // idempotent; a second attempt hits `update` (owner-only) or is denied.
      // `activeInOrg`: an invited/pending/disabled member reads nothing, and a
      // member of a `suspended` company reads nothing below the org document.
      // Single-company policy (§2): a bound account
      // (invited/pending_activation/active) cannot create a second company —
      //sign-out alone never unblocks this, only leaving does. New companies
      // start active with a full admin founder. Existing trial organizations
      // retain their lifecycle restrictions; clients cannot promote them.
      //
      // The owner may always `get` the org document itself — even when
      // suspended — so the app can render the trial-expired + support screen.
      // A profile-bound member may also `get` the document, but only while the
      // company is `suspended`: a fresh login after expiry must still see the
      // suspension (the client gate reads this document). Members of usable
      // companies keep the previous behavior (`activeInOrg` or nothing), so an
      // invited/pending member still reads nothing.
      // Everything below the org document stays locked by `activeInOrg`.
      allow get: if (resource == null && signedIn() && verifiedEmail()
          && !blocksNewCompany(request.auth.uid))
        || activeInOrg(orgId)
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || (signedIn() && hasProfile() && myOrg() == orgId
            && resource.data.status == 'suspended');
      allow list: if false;
      allow create: if signedIn()
        && verifiedEmail()
        && !exists(/databases/$(database)/documents/organizations/$(orgId))
        && !blocksNewCompany(request.auth.uid)
        && request.resource.data.keys().hasOnly([
             'name','ownerUid','status','createdAt','createdBy','schemaVersion',
             'updatedBy','updatedAt','version',
             'trialStartedAt','trialEndsAt','trialConsumed','manuallyActivated','commandProtocol'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.trialConsumed == true
        && request.resource.data.manuallyActivated == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.schemaVersion == 3
        && request.resource.data.commandProtocol == {
          'enabled': true, 'schemaVersion': 3, 'domainManifestVersion': 1,
          'migrationId': 'fresh_' + orgId, 'mode': 'firestore_direct_v2',
          'writePolicy': 'multi_authorized', 'maintenance': false,
          'globalReferencesReady': true, 'uniqueAdmissionComplete': true
        }
        && getAfter(/databases/$(database)/documents/organizations/$(orgId)/counters/changeSequence).data
          == {'organizationId': orgId, 'value': 0}
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId == orgId
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
        && getAfter(/databases/$(database)/documents/organizations/$(orgId)/members/$(getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.memberId)).data.uid == request.auth.uid
        && request.resource.data.get('trialStartedAt', null) == null
        && request.resource.data.get('trialEndsAt', null) == null
        && request.resource.data.version == 1;
      // No client may change the organization lifecycle: `status`,
      // `trialStartedAt`, `trialEndsAt`, `trialConsumed` and
      // `manuallyActivated` are pinned. Reviewed lifecycle administration
      // uses trusted credentials; no cron or Functions are required.
      // An active admin of a usable
      // org may still rename it or bump the schema version.
      allow update: if can(orgId, 'org.update')
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.status == resource.data.status
        && request.resource.data.get('trialStartedAt', null) == resource.data.get('trialStartedAt', null)
        && request.resource.data.get('trialEndsAt', null) == resource.data.get('trialEndsAt', null)
        && request.resource.data.get('trialConsumed', false) == resource.data.get('trialConsumed', false)
        && request.resource.data.get('manuallyActivated', false) == resource.data.get('manuallyActivated', false)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name','schemaVersion','updatedBy','updatedAt','version']);
      allow delete: if false;

      // BEGIN SECURE METADATA
      allow update: if secureOrganizationEdit(orgId);
      match /secureVisibility/{uid} {
        allow get: if activeInOrg(orgId) && request.auth.uid == uid;
        allow list, delete: if false;
        allow create, update: if request.auth.uid == uid && secureManager(orgId) && writerDevice(orgId)
          && request.resource.data.keys().hasOnly(['enabled','authTime','deviceId','updatedAt'])
          && request.resource.data.enabled is bool
          && request.resource.data.authTime == request.auth.token.auth_time
          && request.resource.data.updatedAt == request.time;
      }
      match /secureControl/{id} {
        allow get: if id == 'state' && activeInOrg(orgId);
        allow list, delete: if false;
        allow create, update: if id == 'state' && secureControlEdit(orgId);
      }
      // END SECURE METADATA

      // Heartbeat written by the sync engine.
      match /meta/{docId} {
        allow get: if inOrg(orgId);
        allow list: if false;
        allow create: if activeInOrg(orgId)
          && request.resource.data.keys().hasOnly([
               'lastWriteAt','lastWriteBy','lastEntity','version'])
          && request.resource.data.lastWriteBy == request.auth.uid;
        allow update: if activeInOrg(orgId)
          && request.resource.data.keys().hasOnly([
               'lastWriteAt','lastWriteBy','lastEntity','version'])
          && request.resource.data.lastWriteBy == request.auth.uid;
        allow delete: if false;
      }

      // Invitations are readable by the invited e-mail only; the admin sees
      // them through `list`.
      //
      // The document id is `inviteKey(email)` (derived, guessable), but the
      // `get` gate still checks the *stored* e-mail against the token e-mail,
      // and the org id itself (`org_…`) is unguessable — so enumerating
      // another org's roster would need both its org id and a matching token
      // e-mail. Cross-org reads stay denied (emulator: invite confidentiality).
      // Admins of the owning org are also allowed, to resolve one by key.
      // Immutable validation witnesses for one atomic analysis definition.
      // Root data is the read model; these documents only distribute the
      // inventory checks across writes within Firestore's per-write budget.
      match /simpleOperationProofs/{proofId} {
        allow create: if signedIn() && proofId == request.resource.data.operationId
          && simpleProofAllowed(orgId, request.resource.data);
        allow read, update, delete: if false;
      }
      match /analysisDefinitionProofs/{proofId} {
        function approvedAnalysisProof() {
          let d = request.resource.data;
          let a = getAfter(/databases/$(database)/documents/organizations/$(orgId)/labConfig/$(d.analysisId)).data;
          return signedIn() && d.keys().hasOnly(['analysisId','operationId','summary','block','blocks','committedAt'])
            && a.organizationId == orgId && a.protocol.entityType == 'labAnalysis'
            && a.updatedBy == request.auth.uid && a.updatedAt == request.time
            && a.protocol.operationId == d.operationId && d.committedAt == request.time
            && (d.summary == true
              ? proofId == d.operationId + '_' + d.analysisId + '_summary'
                && chemicalAllBlocks(orgId, a, d.blocks)
              : d.summary == false && d.block is int && d.block >= 0 && d.block < 9
                && proofId == d.operationId + '_' + d.analysisId + '_' + string(d.block)
                && d.block * 4 < a.chemicalDefinitions.size()
                && chemicalAt(orgId, a, d.block * 4)
                && chemicalAt(orgId, a, d.block * 4 + 1)
                && chemicalAt(orgId, a, d.block * 4 + 2)
                && chemicalAt(orgId, a, d.block * 4 + 3));
        }
        allow create: if approvedAnalysisProof();
        allow read, update, delete: if false;
      }

      match /invites/{inviteKey} {
        allow get: if can(orgId, 'users.read')
          || (verifiedEmail()
              && resource.data.email is string
              && resource.data.email.lower() == request.auth.token.email.lower());
        allow list: if can(orgId, 'users.read');
        allow create: if can(orgId, 'users.create')
          && request.resource.data.keys().hasOnly([
               'email','role','roles','memberId','status','invitedBy','invitedByName',
               'createdAt','updatedAt','version'])
          && request.resource.data.email is string
          && request.resource.data.email.size() > 3
          && request.resource.data.email == request.resource.data.email.lower()
          && request.resource.data.role in ['admin','quality_manager','lab','nutritionist','viewer','trial_owner']
          && request.resource.data.role != 'trial_owner'
          && validRoleSet(rolesOf(request.resource.data), request.resource.data.role)
          && request.resource.data.status == 'invited'
          && request.resource.data.memberId is string
          && request.resource.data.memberId.size() > 6
          && request.resource.data.version == 1;
        // Claiming an invite (claimedBy/claimedAt) or refreshing the invite.
        allow update: if (verifiedEmail()
                           && resource.data.email.lower() == request.auth.token.email.lower()
                           && request.resource.data.diff(resource.data).affectedKeys()
                                .hasOnly(['claimedBy','claimedAt','updatedAt','version'])
                           && request.resource.data.email == resource.data.email
                           && request.resource.data.role == resource.data.role
                           && request.resource.data.memberId == resource.data.memberId)
                       || (can(orgId, 'users.create')
                           && request.resource.data.diff(resource.data).affectedKeys()
                                .hasOnly(['role','roles','status','version','updatedBy','updatedAt'])
                           && request.resource.data.email == resource.data.email
                           && request.resource.data.memberId == resource.data.memberId
                           && validRoleSet(rolesOf(request.resource.data), request.resource.data.role));
        allow delete: if can(orgId, 'users.update');
      }

      match /members/{memberId} {

        function memberKeysOk() {
          return request.resource.data.keys().hasAll([
                   'uid','email','role','status','version','updatedBy','updatedAt','createdAt'])
              && request.resource.data.email is string
              && request.resource.data.role in ['admin','quality_manager','lab','nutritionist','viewer','trial_owner']
              && validRoleSet(rolesOf(request.resource.data), request.resource.data.role)
              && request.resource.data.status in ['invited','pending_activation','active','disabled']
              && request.resource.data.version == 1;
        }

        function profileDocumentMatchesMember(memberUid) {
          let profile = getAfter(/databases/$(database)/documents/users/$(memberUid));
          return profile != null
            && profile.data.memberId == memberId
            && profile.data.role == request.resource.data.role
            && rolesMatch(profile.data, request.resource.data)
            && profile.data.status == request.resource.data.status;
        }

        function profileAfterMatchesMember() {
          let memberUid = resource.data.uid;
          return memberUid == '' || memberUid == null
            || profileDocumentMatchesMember(memberUid);
        }

        function disabledProfileAfterMatchesMember() {
          let memberUid = resource.data.get('uid', '');
          let profile = memberUid == '' ? null : getAfter(/databases/$(database)/documents/users/$(memberUid));
          return memberUid == '' || (profile != null
            && profile.data.status == 'disabled'
            && !profile.data.keys().hasAny(['organizationId','memberId'])
            && profile.data.role == resource.data.role
            && rolesMatch(profile.data, resource.data));
        }

        // Admin inviting a member: the member document may only be created in
        // the `invited` state - an admin cannot mint an active member.
        function invitedByAdmin() {
          return can(orgId, 'users.create') && memberKeysOk()
            && request.resource.data.role != 'trial_owner'
            && request.resource.data.status == 'invited';
        }

        // Organization founder writing its own member document: an active
        // `admin` for a full company, an active `trial_owner` for a trial.
        function founderMember() {
          let org = getAfter(/databases/$(database)/documents/organizations/$(orgId));
          return request.resource.data.uid == request.auth.uid
            && memberKeysOk()
            && request.resource.data.email.lower() == request.auth.token.email.lower()
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.status == 'active'
            && org != null
            && org.data.ownerUid == request.auth.uid
                  && ((org.data.status == 'trial'
                  && request.resource.data.role == 'trial_owner'
                  && rolesOf(request.resource.data) == ['trial_owner'])
                || (org.data.status == 'active'
                  && request.resource.data.role == 'admin'
                  && rolesOf(request.resource.data) == ['admin']));
        }

        allow get, list: if activeInOrg(orgId);
        allow create: if invitedByAdmin() || founderMember();
        allow update: if (
              // Manager activation (plan §6): role / status / activation audit
              // only, version bumps by exactly one in the same batch as
              // `users/{uid}`. Activation only moves invited/pending → active;
              // a member can never activate itself (see the claim branch: it
              // cannot touch `status` at all). Refreshing an invite
              // (resend: version/updated bump while `invited`) is also here.
              (request.resource.data.status == resource.data.status
                || (resource.data.status in ['invited','pending_activation']
                    && request.resource.data.status == 'active'))
              && can(orgId, 'users.update')
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                   'role','roles','status','displayName','activatedAt','activatedBy',
                   'updatedBy','updatedAt','version','deletedAt',
                   'invitedBy','invitedByName','invitedAt'])
              && request.resource.data.email == resource.data.email
              && validRoleSet(rolesOf(request.resource.data), request.resource.data.role)
              && profileAfterMatchesMember()
              && request.resource.data.version == resource.data.version + 1
              && (request.resource.data.status == resource.data.status
                  || (resource.data.status in ['invited','pending_activation']
                      && request.resource.data.status == 'active'))
            ) || (
              // Manager disable/remove (tombstone, never delete): an
              // `invited`/`pending_activation`/`active` row moves to
              // `disabled`. Gated on `users.disable`, never on `users.update`,
              // so a role with only `users.update` cannot revoke access.
              resource.data.uid != request.auth.uid
              && can(orgId, 'users.disable')
              && resource.data.status in ['invited','pending_activation','active']
              && request.resource.data.status == 'disabled'
              && disabledProfileAfterMatchesMember()
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status','deletedAt','updatedBy','updatedAt','version'])
              && request.resource.data.uid == resource.data.uid
              && request.resource.data.role == resource.data.role
              && rolesMatch(request.resource.data, resource.data)
              && request.resource.data.email == resource.data.email
              && request.resource.data.updatedBy == request.auth.uid
              && request.resource.data.version == resource.data.version + 1)
            || (
              // Invitee claiming their own member document: binds the uid, the
              // status moves invited → pending_activation (waiting for manager
              // activation) and nothing else changes.
              verifiedEmail()
              && resource.data.status == 'invited'
              && resource.data.email is string
              && resource.data.email.lower() == request.auth.token.email.lower()
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['uid','roles','status','updatedBy','updatedAt','version'])
              && request.resource.data.status == 'pending_activation'
              && request.resource.data.role == resource.data.role
              && validRoleSet(rolesOf(request.resource.data), request.resource.data.role)
              && rolesMatch(request.resource.data, resource.data)
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.updatedBy == request.auth.uid
              // Same envelope invariant as every other write: exactly one step.
              && request.resource.data.version == resource.data.version + 1)
            || (
              // Self-service departure: a member leaving on their own. Any role
              // may do this, which is why it is not gated on `users.update`.
              // It can only ever move the row to `disabled` — never change the
              // role, the e-mail or the member id, so leaving can never be used
              // to escalate.
              verifiedEmail()
              && resource.data.status in ['invited','pending_activation','active']
              && resource.data.uid == request.auth.uid
              && request.resource.data.status == 'disabled'
              && disabledProfileAfterMatchesMember()
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status','deletedAt','updatedBy','updatedAt','version'])
              && request.resource.data.uid == resource.data.uid
              && request.resource.data.role == resource.data.role
              && rolesMatch(request.resource.data, resource.data)
              && request.resource.data.email == resource.data.email
              && request.resource.data.updatedBy == request.auth.uid
              && request.resource.data.version == resource.data.version + 1);
        // Disabling is a status change (tombstone), never a delete.
        allow delete: if false;
      }

      // ── synced domain documents (plan §6.1) ───────────────────────────
      match /parameters/{docId} {
        function directShape() {
          return request.resource.data.remoteId == docId && (shape_parameter(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'samples.read');
        allow create: if roleCan('reference.update') && hasEnvelope(orgId) && directShape();
        allow update: if roleCan('reference.update') && bumped(orgId) && directShape();
        allow delete: if false;
      }
      match /materialBounds/{docId} {
        function directShape() {
          return request.resource.data.remoteId == docId && (shape_materialBound(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'samples.read');
        allow create: if roleCan('reference.update') && hasEnvelope(orgId) && directShape();
        allow update: if roleCan('reference.update') && bumped(orgId) && directShape();
        allow delete: if false;
      }
      match /organizationSettings/{docId} {
        function directShape() {
          return request.resource.data.remoteId == docId && (shape_organizationSetting(orgId, request.resource.data));
        }
        function sharedKey() {
          return request.resource.data.key in [
            'department_label','report_logo_data_uri','qa_form_no',
            'inspection_report_form_no','inspection_label_form_no',
            'equipment_label_form_no','daily_report_form_no','monthly_report_form_no',
            'yearly_report_form_no','product_daily_report_form_no',
            'product_monthly_report_form_no','product_yearly_report_form_no',
            'followup_report_form_no','lab_daily_report_form_no',
            'lab_monthly_report_form_no','lab_yearly_report_form_no','ncr_report_form_no'];
        }
        allow read: if can(orgId, 'reports.read');
        allow create: if roleCan('reports.create') && hasEnvelope(orgId)
          && sharedKey() && request.resource.data.value is string && directShape();
        allow update: if roleCan('reports.create') && bumped(orgId)
          && sharedKey() && request.resource.data.key == resource.data.key
          && request.resource.data.value is string && directShape();
        allow delete: if false;
      }
      match /qcSops/{docId} {
        function directShape() {
          return (shape_qcSop(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'qc.read');
        allow create: if roleCan('qc.write') && hasEnvelope(orgId)
          && (!(request.resource.data.status in ['Approved','Published']) || roleCan('qc.approve')) && directShape();
        allow update: if roleCan('qc.write') && bumped(orgId)
          && (request.resource.data.status == resource.data.status
              || !(request.resource.data.status in ['Approved','Published'])
              || roleCan('qc.approve')) && directShape();
        allow delete: if false;
      }
      match /qcSopRevisions/{docId} {
        function directShape() {
          return (shape_qcSopRevision(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'qc.read');
        allow create: if roleCan('qc.approve') && hasEnvelope(orgId) && directShape();
        allow update: if roleCan('qc.approve') && bumped(orgId) && directShape();
        allow delete: if false;
      }
      match /qcSopReads/{docId} {
        function directShape() {
          return (shape_qcSopRead(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'qc.read');
        allow create: if roleCan('qc.write') && hasEnvelope(orgId) && directShape();
        allow update: if roleCan('qc.write') && bumped(orgId) && directShape();
        allow delete: if false;
      }

      match /samples/{docId} {
        function directShape() {
          return (shape_sample(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'samples.read');
        allow create: if roleCan('samples.create') && hasEnvelope(orgId) && directShape();
        allow update: if roleCan('samples.update') && bumped(orgId) && directShape();
        allow delete: if false; // tombstone only (`deletedAt`)
      }

      // Append-only decision log.
      //
      // `newStatus` is constrained to the four decision codes the app writes
      // (`lib/core/domain/rules.dart` `decisionCodes`). Previously any string
      // other than `'approved'` was accepted under `qc.reject`, so a member
      // could write a bogus/near-miss decision state into the ledger. Approvals
      // require `qc.approve`, rejections require `qc.reject`.
      match /qualityChecks/{docId} {
        function directShape() {
          return (shape_qualityCheck(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'samples.read');
        allow create: if hasEnvelope(orgId)
          && request.resource.data.newStatus in [
               'APPROVED','CONDITIONAL_APPROVAL','PARTIAL_REJECTION','FULL_REJECTION']
          && ((request.resource.data.newStatus in ['APPROVED','CONDITIONAL_APPROVAL']
                 && roleCan('qc.approve'))
              || (request.resource.data.newStatus in ['PARTIAL_REJECTION','FULL_REJECTION']
                 && roleCan('qc.reject'))) && directShape();
        allow update: if false && directShape();
        allow delete: if false;
      }

      match /labResults/{docId} {
        function directShape() {
          return request.resource.data.remoteId == docId && (shape_labResult(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'lab_results.read');
        allow create: if roleCan('lab_results.create') && hasEnvelope(orgId) && directShape();
        allow update: if roleCan('lab_results.update') && bumped(orgId) && directShape();
        allow delete: if false;
      }

      match /labConfig/{docId} {
        // SECURE FORMULA MIGRATION
        allow update: if secureFormulationMigration(orgId, request.resource.data) && bumped(orgId) && directShape();
        function directShape() {
          return request.resource.data.remoteId == docId && ((request.resource.data.configType == 'secure_field_submissions' && shape_secureFieldSubmission(orgId, request.resource.data))
            || (request.resource.data.configType == 'lab_analyses' && shape_labAnalysis(orgId, request.resource.data))
            || (request.resource.data.configType == 'lab_analysis_items' && shape_labAnalysisItem(orgId, request.resource.data))
            || (request.resource.data.configType == 'lab_field_chemical_links' && shape_labFieldLink(orgId, request.resource.data))
            || (request.resource.data.configType == 'lab_constants' && shape_labConstant(orgId, request.resource.data))
            || (request.resource.data.configType == 'lab_products' && shape_labProduct(orgId, request.resource.data))
            || (request.resource.data.configType == 'nutrition_formulations' && shape_nutritionFormulation(orgId, request.resource.data))
            || (request.resource.data.configType == 'lab_product_analyses' && shape_labProductAnalysis(orgId, request.resource.data))
            || (request.resource.data.configType == 'lab_units' && shape_labUnit(orgId, request.resource.data))
            || (request.resource.data.configType == 'lab_material_analyses' && shape_labMaterialAnalysis(orgId, request.resource.data))
            || (request.resource.data.configType == 'nir_validation_settings' && shape_nirValidationSettings(orgId, request.resource.data)));
        }
        allow get: if resource == null && (can(orgId, 'lab_results.read') || can(orgId, 'formulations.read'));
        allow read: if resource != null && (resource.data.configType == 'secure_field_submissions'
          ? secureReveal(orgId) : (resource.data.configType.matches('nutrition_.*')
            ? can(orgId, 'formulations.read') : can(orgId, 'samples.read')));
        allow create: if labConfigCanWrite(request.resource.data.configType, 'create')
          && hasEnvelope(orgId) && directShape();
        allow update: if labConfigCanWrite(request.resource.data.configType, 'update')
          && request.resource.data.configType == resource.data.configType
          && bumped(orgId) && directShape();
        allow delete: if false;
      }

      // Comprehensive sync (plan §7): inventory / ledger / equipment /
      // worksheets / reference. Same envelope + version-bump contract as
      // the core collections; append-only ledgers reject update/delete.
      match /inventoryItems/{docId} {
        function directShape() {
          return request.resource.data.remoteId == docId && (shape_inventoryItem(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'lab_results.read');
        allow create: if roleCan('lab_results.create') && hasEnvelope(orgId) && directShape();
        allow update: if roleCan('lab_results.update') && bumped(orgId) && directShape();
        allow delete: if false;
      }

      match /inventoryTransactions/{docId} {
        function directShape() {
          return request.resource.data.remoteId == docId && (shape_inventoryTransaction(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'lab_results.read');
        allow create: if roleCan('lab_results.create') && hasEnvelope(orgId) && directShape();
        allow update: if false && directShape();
        allow delete: if false;
      }

      match /inventoryLots/{docId} {
        function directShape() {
          return request.resource.data.remoteId == docId && (shape_inventoryLot(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'lab_results.read');
        allow create: if roleCan('lab_results.create') && hasEnvelope(orgId) && directShape();
        allow update: if roleCan('lab_results.update') && bumped(orgId) && directShape();
        allow delete: if false;
      }

      match /consumption/{docId} {
        function directShape() {
          return request.resource.data.remoteId == docId && (shape_consumption(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'lab_results.read');
        allow create: if roleCan('lab_results.create') && hasEnvelope(orgId) && directShape();
        allow update: if false && directShape();
        allow delete: if false;
      }

      match /stockAdjustments/{docId} {
        function directShape() {
          return (shape_stockAdjustment(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'lab_results.read');
        allow create: if roleCan('lab_results.create') && hasEnvelope(orgId) && directShape();
        allow update: if false && directShape();
        allow delete: if false;
      }

      match /equipment/{docId} {
        function directShape() {
          return request.resource.data.remoteId == docId && (shape_equipment(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'lab_results.read');
        allow create: if roleCan('lab_results.create') && hasEnvelope(orgId) && directShape();
        allow update: if roleCan('lab_results.update') && bumped(orgId) && directShape();
        allow delete: if false;
      }

      match /equipmentEvents/{docId} {
        function directShape() {
          return request.resource.data.remoteId == docId && (shape_equipmentEvent(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'lab_results.read');
        allow create: if roleCan('lab_results.create') && hasEnvelope(orgId) && directShape();
        allow update: if roleCan('lab_results.update') && bumped(orgId) && directShape();
        allow delete: if false;
      }

      match /worksheets/{docId} {
        function directShape() {
          return request.resource.data.remoteId == docId && (shape_worksheet(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'lab_results.read');
        allow create: if roleCan('lab_results.create') && hasEnvelope(orgId) && directShape();
        allow update: if roleCan('lab_results.update') && bumped(orgId) && directShape();
        allow delete: if false;
      }

      match /referenceMaterials/{docId} {
        function directShape() {
          return request.resource.data.remoteId == docId && (shape_referenceMaterial(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'samples.read');
        allow create: if roleCan('reference.update') && hasEnvelope(orgId) && directShape();
        allow update: if roleCan('reference.update') && bumped(orgId) && directShape();
        allow delete: if false;
      }

      // Product batch samples (محضر التشغيلة rows): source data only.
      // Same envelope + version-bump contract as labResults; derived
      // artifacts (PDF/HTML) are never stored here — rebuilt on-device.
      match /productBatchSamples/{docId} {
        function directShape() {
          return (shape_productBatchSample(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'lab_results.read');
        allow create: if roleCan('lab_results.create') && hasEnvelope(orgId) && directShape();
        allow update: if roleCan('lab_results.update') && bumped(orgId) && directShape();
        allow delete: if false;
      }

      // QC user-authored tables (the QC settings feature): definition,
      // typed columns, records. Same envelope + version-bump contract;
      // children carry the parent's remote id so the pull remaps the
      // per-device `table_id`. Deletes stay tombstone-only.
      match /qcCustomTables/{docId} {
        function directShape() {
          return request.resource.data.remoteId == docId && (shape_qcCustomTable(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'qc.read');
        allow create: if roleCan('qc.write') && hasEnvelope(orgId) && directShape();
        allow update: if roleCan('qc.write') && bumped(orgId) && directShape();
        allow delete: if false;
      }

      match /qcCustomTableFields/{docId} {
        function directShape() {
          return request.resource.data.remoteId == docId && (shape_qcCustomTableField(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'qc.read');
        allow create: if roleCan('qc.write') && hasEnvelope(orgId) && directShape();
        allow update: if roleCan('qc.write') && bumped(orgId) && directShape();
        allow delete: if false;
      }

      match /qcCustomTableRows/{docId} {
        function directShape() {
          return request.resource.data.remoteId == docId && (shape_qcCustomTableRow(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'qc.read');
        allow create: if roleCan('qc.write') && hasEnvelope(orgId) && directShape();
        allow update: if roleCan('qc.write') && bumped(orgId) && directShape();
        allow delete: if false;
      }

      // QC checklists and their execution + the NCR/CAPA pipeline (plan P8).
      // Same envelope + tombstone-only delete contract as the QC custom
      // tables; children carry the parent's remote id (`template_remote_id`,
      // `inspection_remote_id`, ...) so the pull remaps the per-device
      // autoincrement foreign keys.
      match /qcTemplates/{docId} {
        function directShape() {
          return (shape_qcTemplate(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'qc.read');
        allow create: if roleCan('qc.write') && hasEnvelope(orgId) && directShape();
        allow update: if roleCan('qc.write') && bumped(orgId) && directShape();
        allow delete: if false;
      }

      match /qcSections/{docId} {
        function directShape() {
          return (shape_qcSection(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'qc.read');
        allow create: if roleCan('qc.write') && hasEnvelope(orgId) && directShape();
        allow update: if roleCan('qc.write') && bumped(orgId) && directShape();
        allow delete: if false;
      }

      match /qcItems/{docId} {
        function directShape() {
          return (shape_qcItem(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'qc.read');
        allow create: if roleCan('qc.write') && hasEnvelope(orgId) && directShape();
        allow update: if roleCan('qc.write') && bumped(orgId) && directShape();
        allow delete: if false;
      }

      match /qcInspections/{docId} {
        function directShape() {
          return (shape_qcInspection(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'qc.read');
        allow create: if roleCan('qc.write') && hasEnvelope(orgId) && directShape();
        allow update: if roleCan('qc.write') && bumped(orgId) && directShape();
        allow delete: if false;
      }

      match /qcResponses/{docId} {
        function directShape() {
          return (shape_qcResponse(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'qc.read');
        allow create: if roleCan('qc.write') && hasEnvelope(orgId) && directShape();
        allow update: if roleCan('qc.write') && bumped(orgId) && directShape();
        allow delete: if false;
      }

      // Every press of the per-task "done" button appends one row: there is
      // no edit path, so the collection is append-only.
      match /qcTaskLogs/{docId} {
        function directShape() {
          return (shape_qcTaskLog(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'qc.read');
        allow create: if roleCan('qc.write') && hasEnvelope(orgId) && directShape();
        allow update: if false && directShape();
        allow delete: if false;
      }

      match /qcFindingsNc/{docId} {
        function directShape() {
          return (shape_qcFindingNc(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'qc.read');
        allow create: if roleCan('qc.write') && hasEnvelope(orgId) && directShape();
        allow update: if roleCan('qc.write') && bumped(orgId) && directShape();
        allow delete: if false;
      }

      match /qcCapa/{docId} {
        function directShape() {
          return (shape_qcCapa(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'qc.read');
        allow create: if roleCan('qc.write') && hasEnvelope(orgId) && directShape();
        allow update: if roleCan('qc.write') && bumped(orgId) && directShape();
        allow delete: if false;
      }

      // Push tokens are private per-device infrastructure. Read-only viewers
      match /qcAudits/{docId} {
        function directShape() {
          return (shape_qcAudit(orgId, request.resource.data));
        }
        allow read: if can(orgId, 'qc.read');
        // Fail closed until the generated target/hash/operation contract is present.
        allow create: if roleCan('qc.write') && hasEnvelope(orgId) && directShape();
        allow update, delete: if false;
      }

      // Push tokens are private per-device infrastructure. Read-only viewers
      // may register their own token; tokens never grant domain permissions.
      match /pushTokens/{tokenId} {
        function tokenShapeOk() {
          return request.resource.data.keys().hasOnly([
            'uid','deviceId','token','platform','updatedAt'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.token is string
            && request.resource.data.token.size() > 0
            && request.resource.data.token.size() <= 4096
            && request.resource.data.deviceId is string
            && request.resource.data.platform in ['android','ios']
            && request.resource.data.updatedAt is string;
        }
        function ownsPushDevice() {
          let device = get(/databases/$(database)/documents/organizations/$(orgId)/devices/$(request.resource.data.deviceId));
          return device != null && device.data.uid == request.auth.uid
            && device.data.get('status', 'active') != 'revoked';
        }
        allow read: if false;
        allow create: if activeInOrg(orgId) && tokenShapeOk() && ownsPushDevice();
        allow update: if activeInOrg(orgId) && tokenShapeOk() && ownsPushDevice()
          && resource.data.uid == request.auth.uid
          && request.resource.data.deviceId == resource.data.deviceId;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }

      // Device inventory: a member may only write its own document, admins may
      // refresh or revoke any of them.
      match /devices/{deviceId} {
        // The exact field set `DeviceRegistry` can ever write. `revokedAt` /
        // `revokedReason` / `status` come from `revoke()`; the rest from
        // `register()` and the `lastSeenAt` heartbeat. Writes are merge-sets,
        // so this is the union of every partial payload.
        function deviceKeysOk() {
          return request.resource.data.keys().hasOnly([
            'uid','email','displayName','platform','role','readOnly',
            'lastSeenAt','status','revokedAt','revokedReason','version']);
        }

        // `activeInOrg`, not `inOrg`: an invited/disabled member must not be
        // able to list every member's uid, e-mail, platform and role.
        // `list` needs `devices.read` (admins); `get` additionally allows the
        // owner to read their own document (heartbeat/register needs it).
        allow get: if (resource == null && can(orgId, 'devices.register'))
          || can(orgId, 'devices.read')
          || (activeInOrg(orgId)
              && resource.data.uid == request.auth.uid);
        allow list: if can(orgId, 'devices.read');
        allow create: if activeInOrg(orgId)
          && can(orgId, 'devices.register')
          && deviceKeysOk()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.version == 1;
        // Ownership is checked against the **stored** document. Checking
        // `request.resource.data.uid` instead (as this used to) meant any
        // member could write their own uid into anybody's device document, and
        // with no `hasOnly` they could then set arbitrary fields on it.
        //
        // The admin branch additionally may not re-assign ownership: `revoke()`
        // blanks the uid (it acts on a device it did not create), and nothing
        // legitimately changes it.
        allow update: if activeInOrg(orgId) && ((resource.data.uid == request.auth.uid
                          && request.resource.data.uid == resource.data.uid
                          && deviceKeysOk()
                          && request.resource.data.get('readOnly', true) == resource.data.get('readOnly', true)
                          // Owner heartbeat/register must never change the
                          // revocation state: self sign-out goes through the
                          // same branch but only `active → revoked`, never
                          // `revoked → active` (no self un-revoke).
                          && (request.resource.data.get('status', 'active')
                                == resource.data.get('status', 'active')
                              || (resource.data.get('status', 'active') == 'active'
                                  && request.resource.data.get('status', 'active') == 'revoked')))
                      || (can(orgId, 'devices.update')
                          && deviceKeysOk()
                          && request.resource.data.uid in [resource.data.uid, '']
                          // Admins may revoke but never un-revoke either.
                          && (request.resource.data.get('status', 'active')
                                == resource.data.get('status', 'active')
                              || (resource.data.get('status', 'active') != 'revoked'
                                  && request.resource.data.get('status', 'active') == 'revoked'))));
        allow delete: if false;
      }

      // A private append acknowledgement is part of the same transaction as
      // its business record. It exposes hashes, never laboratory values.
      match /syncReceipts/{uid}/entries/{receiptId} {
        allow get: if activeInOrg(orgId) && request.auth.uid == uid;
        allow list: if false;
        allow create: if activeInOrg(orgId) && request.auth.uid == uid
          && activeOwnedDevice(orgId, request.resource.data.get('deviceId', ''))
          && request.resource.data.keys().hasOnly([
            'fingerprint','deviceId','collectionId','documentId','version','createdAt'])
          && receiptId.matches('^[a-f0-9]{64}$')
          && request.resource.data.fingerprint is string
          && request.resource.data.fingerprint.matches('^[a-f0-9]{64}$')
          && request.resource.data.collectionId in [
            'qualityChecks','inventoryTransactions','consumption','stockAdjustments','qcTaskLogs','auditLogs']
          && request.resource.data.documentId is string
          && request.resource.data.documentId.size() > 0
          && request.resource.data.version == 1
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }

      match /auditLogs/{docId} {
        allow read: if can(orgId, 'audit.read');
        allow create: if request.resource.data.userId == request.auth.uid
          && request.resource.data.organizationId == orgId
          && request.resource.data.version == 1
          && request.resource.data.keys().hasOnly(['userId','userName','organizationId','action','entityType','entityId','detailsJson','deviceId','occurredAt','version','operationId','sequence','records'])
          && (request.resource.data.action == 'DOMAIN_COMMITTED'
            ? (directMetadataLinked(orgId) && docId == 'cmd_' + request.resource.data.operationId
              && request.resource.data.occurredAt == request.time
              && request.resource.data.detailsJson == ''
              && request.resource.data.entityType == 'domainTransaction'
              && request.resource.data.records == getAfter(/databases/$(database)/documents/organizations/$(orgId)/changeEvents/$(('event_' + string(request.resource.data.sequence)))).data.records)
            : (activeInOrg(orgId) && activeOwnedDevice(orgId, request.resource.data.deviceId)
              && validAuditAction(request.resource.data.action)));
        allow update, delete: if false;
      }

      // ── Central command protocol (plan 2026-10-25 §6/§9) ────────────────
      // After cutover, clients NEVER write business records directly: the
      // command service writes them. These store collections are written
      // only by the Admin SDK (bypassing rules); clients read only what
      // review/accounting requires.
      //
      // Note (§11, stage 9): this does not yet CLOSE the old direct-write
      // path above — the migration order is "block the old writes first" at
      // cutover. The rules below are the new stores' contract.
      match /commandReceipts/{operationId} {
        // Receipt recovery after "resend the same request": the same actor
        // may read its own receipts; hashes live here, no lab data.
        allow get: if activeInOrg(orgId)
          && (resource == null || resource.data.uid == request.auth.uid);
        allow list: if activeInOrg(orgId) && can(orgId, 'audit.read');
        allow create: if directWriter(orgId, request.resource.data.deviceId) && directMetadataLinked(orgId)
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/counters/changeSequence).data.value == request.resource.data.sequence
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/counters/changeSequence).data.operationId == operationId
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/changeEvents/$(('event_' + string(request.resource.data.sequence)))).data.operationId == operationId
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/auditLogs/$(('cmd_' + operationId))).data.operationId == operationId
          && request.resource.data.keys().hasOnly([
            'organizationId','deviceId','operationId','sequence','uid','requestHash','payloadHash',
            'status','entityId','committedVersion','changeSequence','committedAt','migrationId'])
          && request.resource.data.migrationId == get(/databases/$(database)/documents/organizations/$(orgId)).data.commandProtocol.migrationId
          && operationId == request.resource.data.operationId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'approved'
          && request.resource.data.committedVersion == 1
          && request.resource.data.changeSequence == request.resource.data.sequence
          && request.resource.data.committedAt == request.time
          && request.resource.data.requestHash.matches('^[a-f0-9]{64}$')
          && request.resource.data.payloadHash.matches('^[a-f0-9]{64}$');
        allow update, delete: if false;
      }
      match /changeEvents/{eventId} {
        // Unified reading (§8): members read the change feed for their own
        // organization; every write belongs to the command service.
        allow read: if (can(orgId, 'samples.read') && resource.data.get('entityType', '') == 'sample')
          || (directEnabled(orgId) && resource.data.get('mode', '') == 'firestore_direct_v2');
        allow create: if (request.resource.data.records.size() <= 4 ? directMetadataLinked(orgId) : signedIn())
          && request.resource.data.keys().hasOnly([
            'organizationId','deviceId','operationId','sequence','mode','seq','records','recordPaths','committedAt'])
          && request.resource.data.mode == 'firestore_direct_v2'
          && request.resource.data.seq == request.resource.data.sequence
          && eventId == 'event_' + string(request.resource.data.seq)
          && request.resource.data.committedAt == request.time
          && request.resource.data.recordPaths is list
          && request.resource.data.records is list
          && request.resource.data.recordPaths.size() > 0
          && request.resource.data.recordPaths.size() <= 12
          && request.resource.data.recordPaths.toSet().size() == request.resource.data.recordPaths.size()
          && request.resource.data.records.size() == request.resource.data.recordPaths.size()
          && exactEffects(orgId, request.resource.data);
        allow update, delete: if false;
      }
      match /counters/{counterId} {
        // Server-shared sequence counters — this is THE identity data
        // (official numbers); clients read nothing, write nothing.
        allow get: if directEnabled(orgId) && counterId == 'changeSequence';
        allow update: if counterId == 'changeSequence' && directMetadataLinked(orgId)
          && request.resource.data.keys().hasOnly(['value','organizationId','deviceId','operationId','sequence'])
          && request.resource.data.value is int
          && request.resource.data.value == resource.data.value + 1
          && request.resource.data.value == request.resource.data.sequence;
        // Empty-organization genesis only. Existing organizations cannot use
        // this branch to reset their sequence or bypass reviewed migration.
        allow create: if counterId == 'changeSequence' && signedIn() && verifiedEmail()
          && !exists(/databases/$(database)/documents/organizations/$(orgId))
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)).data.ownerUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)).data.createdAt == request.time
          && request.resource.data == {'organizationId': orgId, 'value': 0};
        allow list, delete: if false;
      }
      match /uniqueReservations/{reservationId} {
        function reservationEffect() {
          let d = request.resource.data;
          let collection = d.collection;
          let record = getAfter(d.recordPath);
          return d.recordPath == /databases/$(database)/documents/organizations/$(orgId)/$(collection)/$(d.entityId)
            && record != null && record.data.updatedAt == request.time
            && record.data.protocol.operationId == d.operationId
            && record.data.protocol.entityType == d.entityType
            && (d.released == false ? record.data.protocol.uniqueKeys.hasAny([reservationId])
              : (resource != null && resource.data.recordPath == d.recordPath
                  && !record.data.protocol.uniqueKeys.hasAny([reservationId])));
        }
        allow get: if directEnabled(orgId);
        allow create, update: if directMetadataLinked(orgId)
          && reservationId.matches('^[a-f0-9]{64}$')
          && request.resource.data.keys().hasOnly([
            'entityType','entityId','organizationId','deviceId','operationId','sequence','released','recordPath','collection'])
          && request.resource.data.entityType is string
          && request.resource.data.entityId is string
          && request.resource.data.released is bool
          && reservationEffect()
          && (resource == null || resource.data.get('released', false) == true
            || (resource.data.entityType == request.resource.data.entityType
                && resource.data.entityId == request.resource.data.entityId));
        allow list, delete: if false;
      }
      match /notifyRequests/{requestId} {
        // Notification fan-out requests, consumed by the push delivery
        // function after the commit. Not client-readable at all.
        allow read, write: if false;
      }

      // Nothing else inside an organization is writable.
      match /{document=**} { allow read, write: if false; }
    }

    // Catch-all: no collection outside the ones above is reachable.
    match /{document=**} { allow read, write: if false; }
  }
}

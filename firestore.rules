rules_version = '2';

// Material Lab - server-confirmed writes and permission-scoped read caching.
//
// The client is NOT trusted: every rule below re-derives the caller's identity
// from `users/{uid}` (the only document the caller can create for itself) and
// never reads a `permissions` array, because permissions are derived from the
// role in `lib/core/auth/permissions.dart` and mirrored in `rolePermissions`.
//
// The role -> permission lists MUST stay byte-identical to the Dart side;
// `test/security/permissions_parity_test.dart` fails the build when they drift.
//
// Document shapes below are the shapes the Dart code actually writes
// (`lib/core/sync/remote/*` and `lib/core/sync/entity_registry.dart`).
service cloud.firestore {
  match /databases/{database}/documents {

    // BEGIN GENERATED DIRECT DOMAIN RULES (generate_rules.js)
function auditQuoted(v) { return "\"" + v.replace("\\\\", "\\\\\\\\").replace("\"", "\\\\\"") + "\""; }

    function auditTextValid(v) { return v is string && v.matches('^[^\\x00-\\x1f]*$'); }

    function qcOperationAudited(orgId, d) {
      let path = /databases/$(database)/documents/organizations/$(orgId)/qcAudits/$(d.protocol.qcAuditId);
      return d.protocol.qcAuditPath == path && getAfter(path).data.protocol.operationId == d.protocol.operationId;
    }
    function qcInspectionDecision(d) {
      let old = resource == null ? '' : resource.data.status;
      return d.status in ['InProgress','Submitted','Reviewed','Approved','Rejected','Closed']
        && ((d.status in ['Approved','Closed'] || old in ['Approved','Closed']
          || !(d.get('approvedBy',null) in [null,'']) || !(d.get('approvedAt',null) in [null,'']) || !(d.get('closedAt',null) in [null,'']))
          ? roleCan('qc.approve') : true)
        && ((d.status == 'Rejected' || old == 'Rejected' || !(d.get('rejectedAt',null) in [null,''])) ? roleCan('qc.reject') : true)
        && (d.get('approvedBy',null) in [null,''] || d.approvedBy == request.auth.uid
          || (resource != null && d.approvedBy == resource.data.approvedBy))
        && (d.get('scorePct',null) == null || (d.scorePct >= 0 && d.scorePct <= 100));
    }
    function qcAuditLinked(orgId, d) {
      let kinds = {'SOP':'qcSop','SOP_REV':'qcSopRevision','SOP_READ':'qcSopRead','TEMPLATE':'qcTemplate','SECTION':'qcSection','ITEM':'qcItem','INSPECTION':'qcInspection','RESPONSE':'qcResponse','FINDING':'qcFindingNc','CAPA':'qcCapa'};
      let collections = {'SOP':'qcSops','SOP_REV':'qcSopRevisions','SOP_READ':'qcSopReads','TEMPLATE':'qcTemplates','SECTION':'qcSections','ITEM':'qcItems','INSPECTION':'qcInspections','RESPONSE':'qcResponses','FINDING':'qcFindingsNc','CAPA':'qcCapa'};
      let targetPath = /databases/$(database)/documents/organizations/$(orgId)/$(collections.get(d.entityType,''))/$(d.targetGlobalId);
      let target = getAfter(targetPath);
      let previous = d.previousAuditId == null ? null : getAfter(/databases/$(database)/documents/organizations/$(orgId)/qcAudits/$(d.previousAuditId));
      let canonical = '{' + '"action":' + auditQuoted(d.action) + ',"after_json":' + auditQuoted(d.afterJson) + ',"at":' + auditQuoted(d.at) + ',"before_json":' + auditQuoted(d.beforeJson) + ',"by_user_id":' + auditQuoted(d.byUserId) + ',"by_user_name":' + auditQuoted(d.byUserName) + ',"entity_id":' + auditQuoted(d.entityId) + ',"entity_type":' + auditQuoted(d.entityType) + ',"meta_json":' + auditQuoted(d.metaJson) + ',"prev_hash":' + auditQuoted(d.prevHash) + '}';
      return d.byUserId == request.auth.uid && d.immutable == 1
        && d.action in ['SOP_CREATED','SOP_UPDATED','SOP_DELETED','SOP_PUBLISHED','SOP_READ','TEMPLATE_CREATED','TEMPLATE_SAVED','TEMPLATE_DELETED','TEMPLATE_PUBLISHED','TEMPLATE_ARCHIVED','TEMPLATE_DUPLICATED','INSPECTION_CREATED','INSPECTION_SAVED','INSPECTION_SUBMITTED','INSPECTION_REVIEWED','INSPECTION_APPROVED','INSPECTION_REJECTED','INSPECTION_DELETED','ITEM_ANSWERED','NC_CREATED','NC_UPDATED','NC_ASSIGNED','NC_VERIFIED','NC_CLOSED','NC_DELETED','CAPA_CREATED','CAPA_UPDATED','CAPA_ACTION_COMPLETE','CAPA_VERIFIED','CAPA_CLOSED']
        && d.targetEntityType == kinds.get(d.entityType, '')
        && d.protocol.auditTargetPath == targetPath
        && target.data.protocol.operationId == d.protocol.operationId
        && target.data.updatedAt == request.time
        && auditTextValid(d.action) && auditTextValid(d.afterJson) && auditTextValid(d.at) && auditTextValid(d.beforeJson) && auditTextValid(d.byUserId) && auditTextValid(d.byUserName) && auditTextValid(d.entityId) && auditTextValid(d.entityType) && auditTextValid(d.metaJson) && auditTextValid(d.prevHash)
        && d.hash == hashing.sha256(canonical.toUtf8()).toHexString().lower()
        && (d.prevHash == '' ? d.previousAuditId == null :
          (previous != null && previous.data.hash == d.prevHash
            && (previous.data.protocol.operationId != d.protocol.operationId
              || previous.data.protocol.auditOrdinal < d.protocol.auditOrdinal)));
    }

    function chemicalAt(orgId, a, index) {
      let defs = a.get('chemicalDefinitions', []);
      return defs.size() <= index || chemicalEntry(orgId, defs[index]);
    }
    function chemicalEntry(orgId, c) {
      let stock = getAfter(/databases/$(database)/documents/organizations/$(orgId)/inventoryItems/$(c.inventoryId));
      return c is map && c.keys().hasOnly(['kind','inventoryId','unit','field','quantity'])
        && c.inventoryId is string && c.inventoryId.size() > 0
        && c.unit is string && stock != null && stock.data.organizationId == orgId
        && stock.data.get('deletedAt', null) == null
        && (stock.data.category == 'liquid' ? c.unit in ['L','mL']
          : stock.data.category == 'powder' ? c.unit in ['kg','g'] : c.unit == 'pc')
        && (c.kind == 'fixed' ? c.quantity is number && c.quantity > 0 && c.quantity < 1000000000000000
          && !c.keys().hasAny(['field'])
          : c.kind == 'link' && c.field is string && c.field.size() > 0 && !c.keys().hasAny(['quantity']));
    }
    function chemicalDefinitionProof(orgId, d) {
      let defs = d.get('chemicalDefinitions', []);
      return defs is list && defs.size() <= 36
        && (defs.size() == 0 || d.deletedAt != null || chemicalSummary(orgId, d));
    }
    function chemicalSummary(orgId, d) {
      let id = d.protocol.operationId + '_' + d.remoteId + '_summary';
      let proof = getAfter(/databases/$(database)/documents/organizations/$(orgId)/analysisDefinitionProofs/$(id));
      return proof != null && proof.data.analysisId == d.remoteId
        && proof.data.operationId == d.protocol.operationId && proof.data.summary == true
        && proof.data.committedAt == request.time;
    }
    function chemicalBlockProof(orgId, d, block) {
      let id = d.protocol.operationId + '_' + d.remoteId + '_' + string(block);
      let proof = getAfter(/databases/$(database)/documents/organizations/$(orgId)/analysisDefinitionProofs/$(id));
      return proof != null && proof.data.analysisId == d.remoteId
        && proof.data.operationId == d.protocol.operationId && proof.data.summary == false
        && proof.data.block == block && proof.data.committedAt == request.time;
    }
    function chemicalAllBlocks(orgId, a, n) {
      return n == int(math.ceil(a.chemicalDefinitions.size() / 4.0)) && n > 0 && n <= 9
        && (n <= 0 || chemicalBlockProof(orgId, a, 0))
        && (n <= 1 || chemicalBlockProof(orgId, a, 1))
        && (n <= 2 || chemicalBlockProof(orgId, a, 2))
        && (n <= 3 || chemicalBlockProof(orgId, a, 3))
        && (n <= 4 || chemicalBlockProof(orgId, a, 4))
        && (n <= 5 || chemicalBlockProof(orgId, a, 5))
        && (n <= 6 || chemicalBlockProof(orgId, a, 6))
        && (n <= 7 || chemicalBlockProof(orgId, a, 7))
        && (n <= 8 || chemicalBlockProof(orgId, a, 8));
    }
    function optional_string(v) { return v is string || v == null; }
    function optional_int(v) { return v is int || v == null; }
    function optional_number(v) { return v is number || v == null; }
    function keyPart(v) {
      let text = string(v);
      return string(text.toUtf8().size()) + ':' + text;
    }
    function heldUnique(orgId, d, key) {
      let held = getAfter(/databases/$(database)/documents/organizations/$(orgId)/uniqueReservations/$(key));
      return held != null && held.data.released == false
        && held.data.entityType == d.protocol.entityType && held.data.entityId == d.remoteId
        && held.data.recordPath == request.path;
    }
    function parentValid(orgId, d, field, type, collection, configType) {
      let ref = d.parentRefs.get(field, {});
      let id = ref.get('entityId', '');
      let parent = getAfter(/databases/$(database)/documents/organizations/$(orgId)/$(collection)/$(id));
      let data = parent.data;
      return ref.keys().hasOnly(['entityType','entityId','version'])
        && ref.get('entityType', '') == type && id is string && id.size() > 0
        && ref.version is int && ref.version > 0 && parent != null
        && data.organizationId == orgId && data.version == ref.version
        && (!(type == 'labAnalysis' && d.protocol.entityType == 'labResult' && data.keys().hasAny(['chemicalDefinitions'])) || d.protocol.get('chemicalDefinitionAware', false) == true)
        && (!(type == 'labAnalysis' && d.protocol.entityType in ['labAnalysisItem','labFieldLink']) || !data.keys().hasAny(['chemicalDefinitions']))
        && (configType == '' || data.configType == configType)
        && (data.get('deletedAt', null) == null || d.deletedAt != null
          || (resource != null && resource.data.get('parentRefs', {}).get(field, {}).get('entityId', '') == id))
        && (d.protocol.entityType != 'productBatchSample' || data.inspectionKind == 'product');
    }
    // QC parents have no labConfig discriminator, chemical-definition gate
    // or product-sample kind gate. Keep the same reference/version/deletion
    // contract without evaluating those unrelated domain branches per parent.
    function qcParentValid(orgId, d, field, type, collection) {
      let ref = d.parentRefs.get(field, {});
      let id = ref.get('entityId', '');
      let parent = getAfter(/databases/$(database)/documents/organizations/$(orgId)/$(collection)/$(id));
      let data = parent.data;
      return ref.keys().hasOnly(['entityType','entityId','version'])
        && ref.get('entityType', '') == type && id is string && id.size() > 0
        && ref.version is int && ref.version > 0 && parent != null
        && data.organizationId == orgId && data.version == ref.version
        && (data.get('deletedAt', null) == null || d.deletedAt != null
          || (resource != null && resource.data.get('parentRefs', {}).get(field, {}).get('entityId', '') == id));
    }
    function payloadTypes(type, d) {
      return type == 'sample' ? payloadTypes_sample(d) : type == 'productBatchSample' ? payloadTypes_productBatchSample(d) : type == 'qcInspection' ? payloadTypes_qcInspection(d) : type == 'qcResponse' ? payloadTypes_qcResponse(d) : true;
    }
    function effectAt(orgId, e, i) {
      let path = e.recordPaths[i];
      let record = e.records[i];
      let doc = getAfter(path);
      let collection = record.collection;
      return record.keys().hasOnly(['entityType','entityId','version','collection'])
        && record.entityId is string && record.version is int
        && path == /databases/$(database)/documents/organizations/$(orgId)/$(collection)/$(record.entityId)
        && doc != null && doc.data.version == record.version
        && doc.data.remoteId == record.entityId && doc.data.protocol.entityType == record.entityType
        && doc.data.protocol.operationId == e.operationId && doc.data.updatedAt == request.time
        && payloadTypes(record.entityType, doc.data);
    }
    function exactEffects(orgId, e) {
      return e.records.size() <= 4 ? smallEffects(orgId, e) : tableEffects(orgId, e);
    }
    function smallEffects(orgId, e) {
      return e.records.size() > 0 && e.recordPaths.toSet().size() == e.records.size()
        && (e.records.size() <= 0 || effectAt(orgId, e, 0))
        && (e.records.size() <= 1 || effectAt(orgId, e, 1))
        && (e.records.size() <= 2 || effectAt(orgId, e, 2))
        && (e.records.size() <= 3 || effectAt(orgId, e, 3));
    }
    function compactTableEffect(orgId, d, type, collection) {
      let proof = d.protocol.get('effect', null);
      // directShape binds remoteId to the collection's captured docId. Avoid
      // reconstructing the entire request path in every stock/lot write.
      return proof == null || proof == {'entityType':type,'entityId':d.remoteId,'version':d.version,'collection':collection};
    }
    function tableEffectAt(e, i, types) {
      let doc = getAfter(e.recordPaths[i]).data;
      return doc.protocol.entityType in types
        && doc.protocol.effect == e.records[i]
        && doc.protocol.operationId == e.operationId && doc.updatedAt == request.time;
    }
    function tableEffects(orgId, e) {
      // Bind event metadata through its first business effect. That effect's
      // own write rule already requires the same authenticated atomic receipt.
      // Reading the receipt here as well would consume an eleventh lookup for
      // a ten-effect event, beyond Firestore's per-write access-call budget.
      let first = getAfter(e.recordPaths[0]).data;
      let table = first.protocol.entityType in ['qcCustomTable','qcCustomTableField'];
      let consumption = first.protocol.entityType == 'labResult';
      let product = first.protocol.entityType == 'labProduct';
      let simple = first.protocol.entityType in 'parameter,materialBound,organizationSetting,labConstant,labUnit,equipment,equipmentEvent,worksheet,referenceMaterial,labMaterialAnalysis,nutritionFormulation,qcCustomTableRow'.split(',');
      let rt = ['qcAudit','qcItem','qcSection','qcTemplate'];
      let routine = first.protocol.entityType in rt;
      let types = table ? ['qcCustomTable','qcCustomTableField'] : consumption ? ['consumption','inventoryTransaction','inventoryLot','inventoryItem','secureFieldSubmission'] : simple ? 'parameter,materialBound,organizationSetting,labConstant,labUnit,equipment,equipmentEvent,worksheet,referenceMaterial,labMaterialAnalysis,nutritionFormulation,qcCustomTableRow'.split(',') : routine ? rt : ['labAnalysis','labAnalysisItem','labFieldLink','labUnit'];
      return e.records.size() > 0 && e.records.size() <= (simple ? 12 : 10)
        && (product ? e.records.size() <= 7 : (table || consumption || simple || routine || e.records.size() <= 6))
        && e.organizationId == orgId && first.organizationId == orgId
        && first.deviceId == e.deviceId && first.centralSequence == e.sequence
        && e.recordPaths.toSet().size() == e.records.size()
        && (simple && e.records.size() > 10 ? simpleLargeEffects(orgId, e) : (
          (e.records.size() <= 0 || (product ? productEffectAt(e, 0, first.remoteId) : tableEffectAt(e, 0, consumption ? ['labResult'] : types)))
          && (e.records.size() <= 1 || (product ? productEffectAt(e, 1, first.remoteId) : tableEffectAt(e, 1, types)))
          && (e.records.size() <= 2 || (product ? productEffectAt(e, 2, first.remoteId) : tableEffectAt(e, 2, types)))
          && (e.records.size() <= 3 || (product ? productEffectAt(e, 3, first.remoteId) : tableEffectAt(e, 3, types)))
          && (e.records.size() <= 4 || (product ? productEffectAt(e, 4, first.remoteId) : tableEffectAt(e, 4, types)))
          && (e.records.size() <= 5 || (product ? productEffectAt(e, 5, first.remoteId) : tableEffectAt(e, 5, types)))
          && (e.records.size() <= 6 || (product ? productEffectAt(e, 6, first.remoteId) : tableEffectAt(e, 6, types)))
          && (e.records.size() <= 7 || (product ? productEffectAt(e, 7, first.remoteId) : tableEffectAt(e, 7, types)))
          && (e.records.size() <= 8 || (product ? productEffectAt(e, 8, first.remoteId) : tableEffectAt(e, 8, types)))
          && (e.records.size() <= 9 || (product ? productEffectAt(e, 9, first.remoteId) : tableEffectAt(e, 9, types)))));
    }
    function simpleLargeEffects(orgId, e) {
      let proof = getAfter(/databases/$(database)/documents/organizations/$(orgId)/simpleOperationProofs/$(e.operationId)).data;
      return proof.organizationId == orgId && proof.operationId == e.operationId
        && proof.sequence == e.sequence && proof.committedAt == request.time
        && proof.records == e.records && proof.recordPaths == e.recordPaths
        && tableEffectAt(e, 0, 'parameter,materialBound,organizationSetting,labConstant,labUnit,equipment,equipmentEvent,worksheet,referenceMaterial,labMaterialAnalysis,nutritionFormulation,qcCustomTableRow'.split(','))
        && tableEffectAt(e, 1, 'parameter,materialBound,organizationSetting,labConstant,labUnit,equipment,equipmentEvent,worksheet,referenceMaterial,labMaterialAnalysis,nutritionFormulation,qcCustomTableRow'.split(','));
    }
    function simpleProofAt(orgId, d, i) {
      let record = d.records[i];
      let path = d.recordPaths[i];
      let doc = getAfter(path).data;
      return path == /databases/$(database)/documents/organizations/$(orgId)/$(record.collection)/$(record.entityId)
        && doc.organizationId == orgId && doc.protocol.entityType in 'parameter,materialBound,organizationSetting,labConstant,labUnit,equipment,equipmentEvent,worksheet,referenceMaterial,labMaterialAnalysis,nutritionFormulation,qcCustomTableRow'.split(',')
        && doc.protocol.effect == record && doc.protocol.operationId == d.operationId
        && doc.centralSequence == d.sequence && doc.updatedAt == request.time;
    }
    function simpleProofAllowed(orgId, d) {
      let first = getAfter(d.recordPaths[2]).data;
      return d.keys().hasOnly(['organizationId','operationId','sequence','records','recordPaths','committedAt'])
        && d.organizationId == orgId && d.records.size() > 10
        && d.records.size() <= 12 && d.records.size() == d.recordPaths.size()
        && first.updatedBy == request.auth.uid && d.committedAt == request.time
        && (d.records.size() <= 2 || simpleProofAt(orgId, d, 2))
        && (d.records.size() <= 3 || simpleProofAt(orgId, d, 3))
        && (d.records.size() <= 4 || simpleProofAt(orgId, d, 4))
        && (d.records.size() <= 5 || simpleProofAt(orgId, d, 5))
        && (d.records.size() <= 6 || simpleProofAt(orgId, d, 6))
        && (d.records.size() <= 7 || simpleProofAt(orgId, d, 7))
        && (d.records.size() <= 8 || simpleProofAt(orgId, d, 8))
        && (d.records.size() <= 9 || simpleProofAt(orgId, d, 9))
        && (d.records.size() <= 10 || simpleProofAt(orgId, d, 10))
        && (d.records.size() <= 11 || simpleProofAt(orgId, d, 11));
    }
    function productEffectAt(e, i, productId) {
      let doc = getAfter(e.recordPaths[i]).data;
      return (i == 0 ? doc.protocol.entityType == 'labProduct'
        : doc.protocol.entityType == 'labProductAnalysis' && doc.parentRefs.productId.entityId == productId)
        && doc.protocol.effect == e.records[i]
        && doc.protocol.operationId == e.operationId && doc.updatedAt == request.time;
    }
    function ledgerDelta(orgId, d, i) {
      let paths = d.protocol.ledgerPaths;
      return paths.size() <= i ? 0 : getAfter(paths[i]).data.quantityDelta;
    }
    function ledgerEffect(orgId, d, i) {
      let paths = d.protocol.ledgerPaths;
      let ledger = paths.size() <= i ? null : getAfter(paths[i]);
      return paths.size() <= i || (ledger != null
        && ledger.data.protocol.entityType == 'inventoryTransaction'
        && ledger.data.protocol.operationId == d.protocol.operationId
        && ledger.data.parentRefs.inventoryId.entityId == d.remoteId
        && ledger.data.organizationId == orgId && ledger.data.updatedAt == request.time);
    }
    function inventoryBalance(orgId, d) {
      let before = resource == null ? 0 : resource.data.currentQty;
      let compact = d.protocol.get('ledgerMode', '') == 'consumption_v1';
      let delta = compact ? consumptionDelta(d, 0) + consumptionDelta(d, 1) + consumptionDelta(d, 2) + consumptionDelta(d, 3) : (d.protocol.ledgerPaths.size() > 0 ? ledgerDeltaAt(orgId, d, d.protocol.ledgerPaths[0]) : 0) + (d.protocol.ledgerPaths.size() > 1 ? ledgerDeltaAt(orgId, d, d.protocol.ledgerPaths[1]) : 0) + (d.protocol.ledgerPaths.size() > 2 ? ledgerDeltaAt(orgId, d, d.protocol.ledgerPaths[2]) : 0) + (d.protocol.ledgerPaths.size() > 3 ? ledgerDeltaAt(orgId, d, d.protocol.ledgerPaths[3]) : 0);
      let lots = compact ? 0 : (d.protocol.lotPaths.size() > 0 ? lotDeltaAt(orgId, d, d.protocol.lotPaths[0]) : 0) + (d.protocol.lotPaths.size() > 1 ? lotDeltaAt(orgId, d, d.protocol.lotPaths[1]) : 0) + (d.protocol.lotPaths.size() > 2 ? lotDeltaAt(orgId, d, d.protocol.lotPaths[2]) : 0) + (d.protocol.lotPaths.size() > 3 ? lotDeltaAt(orgId, d, d.protocol.lotPaths[3]) : 0);
      let consumed = d.protocol.get('consumptionPaths', []);
      return d.currentQty is number && d.currentQty >= 0 && d.currentQty < 1000000000000000
        && d.protocol.ledgerPaths.size() <= 4 && d.protocol.ledgerPaths.toSet().size() == d.protocol.ledgerPaths.size()
        && d.protocol.lotPaths.size() <= 4 && d.protocol.lotPaths.toSet().size() == d.protocol.lotPaths.size()
        && consumed is list && consumed.size() <= 4 && consumed.toSet().size() == consumed.size()
        && (!compact || (consumed.size() > 0 && d.protocol.ledgerPaths.size() == 0))
        && (compact || math.abs(lots - delta) <= 0.00000001 * (math.abs(delta) > 1 ? math.abs(delta) : 1))
        && math.abs(d.currentQty - before - delta) <= 0.00000001 * (math.abs(before) > math.abs(d.currentQty) ? (math.abs(before) > 1 ? math.abs(before) : 1) : (math.abs(d.currentQty) > 1 ? math.abs(d.currentQty) : 1));
    }
    function ledgerDeltaAt(orgId, d, path) {
      let ledger = getAfter(path);
      return ledger != null && ledger.data.protocol.entityType == 'inventoryTransaction'
        && ledger.data.protocol.operationId == d.protocol.operationId
        && ledger.data.parentRefs.inventoryId.entityId == d.remoteId
        && ledger.data.organizationId == orgId && ledger.data.updatedAt == request.time
        ? ledger.data.quantityDelta : 1000000000000000000;
    }
    function lotDeltaAt(orgId, d, path) {
      let after = getAfter(path);
      let before = get(path);
      return after != null && after.data.organizationId == orgId
        && after.data.protocol.entityType == 'inventoryLot'
        && after.data.parentRefs.inventoryId.entityId == d.remoteId
        && after.data.protocol.operationId == d.protocol.operationId && after.data.updatedAt == request.time
        ? after.data.qtyRemaining - (before == null ? 0 : before.data.qtyRemaining) : 1000000000000000000;
    }
    function lotDelta(orgId, d, i) {
      let paths = d.protocol.lotPaths;
      let path = paths.size() <= i ? null : paths[i];
      let after = path == null ? null : getAfter(path);
      let before = path == null ? null : get(path);
      return path == null ? 0 : (after != null && after.data.organizationId == orgId
        && after.data.protocol.entityType == 'inventoryLot'
        && after.data.parentRefs.inventoryId.entityId == d.remoteId
        && after.data.protocol.operationId == d.protocol.operationId && after.data.updatedAt == request.time
        ? after.data.qtyRemaining - (before == null ? 0 : before.data.qtyRemaining) : 1000000000000000000);
    }
    function consumptionDelta(d, index) {
      let paths = d.protocol.get('consumptionPaths', []);
      let log = paths.size() <= index ? null : getAfter(paths[index]);
      return log == null ? 0 : (log.data.parentRefs.inventoryId.entityId == d.remoteId
        && log.data.protocol.entityType == 'consumption' && log.data.protocol.operationId == d.protocol.operationId
        && log.data.organizationId == d.organizationId && log.data.updatedAt == request.time
        ? (log.data.eventType == 'REVERSAL' ? log.data.appliedQty : -log.data.appliedQty) : 1000000000000000000);
    }
    function consumptionLinked(orgId, d) {
      let item = getAfter(/databases/$(database)/documents/organizations/$(orgId)/inventoryItems/$(d.parentRefs.inventoryId.entityId));
      let result = getAfter(/databases/$(database)/documents/organizations/$(orgId)/labResults/$(d.parentRefs.sampleTestId.entityId));
      return d.eventType in ['CONSUMPTION','REVERSAL']
        && item != null && item.data.organizationId == orgId
        && d.parentRefs.inventoryId == {'entityType':'inventoryItem','entityId':item.data.remoteId,'version':item.data.version}
        && item.data.get('deletedAt', null) == null
        && result != null && result.data.organizationId == orgId
        && d.parentRefs.sampleTestId == {'entityType':'labResult','entityId':result.data.remoteId,'version':result.data.version}
        && (result.data.get('deletedAt', null) == null || (d.eventType == 'REVERSAL' && d.parentRefs.get('reversalOfLogId', null) != null))
        && result.data.updatedAt == request.time

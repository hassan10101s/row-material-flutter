rules_version = '2';

// Material Lab V2 - multi-organization, offline-first (PLAN_V2 §10).
//
// The client is NOT trusted: every rule below re-derives the caller's identity
// from `users/{uid}` (the only document the caller can create for itself) and
// never reads a `permissions` array, because permissions are derived from the
// role in `lib/core/auth/permissions.dart` and mirrored in `rolePermissions`.
//
// The role -> permission lists MUST stay byte-identical to the Dart side;
// `test/security/permissions_parity_test.dart` fails the build when they drift.
//
// Document shapes below are the shapes the Dart code actually writes
// (`lib/core/sync/remote/*` and `lib/core/sync/entity_registry.dart`).
service cloud.firestore {
  match /databases/{database}/documents {

    // ── identity helpers ─────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function verifiedEmail() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function hasProfile() {
      return signedIn() && userDoc(request.auth.uid) != null;
    }

    function myOrg() {
      return hasProfile() ? userDoc(request.auth.uid).data.organizationId : '';
    }

    function myRole() {
      return hasProfile() ? userDoc(request.auth.uid).data.role : '';
    }

    // `role` is retained as the primary role for old app versions; new member
    // profiles carry the complete additive grant set in `roles`.
    function rolesOf(data) {
      return data.keys().hasAll(['roles']) ? data.roles : [data.role];
    }

    function myRoles() {
      return hasProfile() ? rolesOf(userDoc(request.auth.uid).data) : [];
    }

    function validRoleSet(roles, primaryRole) {
      return roles is list
        && roles.size() > 0
        && roles.size() <= 5
        && roles[0] == primaryRole
        && roles.hasOnly(['admin','quality_manager','lab','nutritionist','viewer','trial_owner'])
        && roles.toSet().size() == roles.size()
        && (roles.size() == 1 || !roles.hasAny(['admin','viewer','trial_owner']));
    }

    function rolesMatch(a, b) {
      return rolesOf(a).hasAll(rolesOf(b))
        && rolesOf(b).hasAll(rolesOf(a));
    }

    function myStatus() {
      return hasProfile() ? userDoc(request.auth.uid).data.status : '';
    }

    function rolePermissions(role) {
      return role == 'admin' ? [
        'org.read','org.update',
        'users.read','users.create','users.update','users.disable',
        'samples.read','samples.create','samples.update',
        'lab_results.read','lab_results.create','lab_results.update',
        'qc.read','qc.write','qc.approve','qc.reject',
        'reports.read','reports.create','reports.export',
        'devices.read','devices.register','devices.update','audit.read',
        'formulations.read','formulations.create','formulations.update'
      ] : role == 'trial_owner' ? [
        'org.read',
        'samples.read','samples.create','samples.update',
        'lab_results.read','lab_results.create','lab_results.update',
        'qc.read','qc.write',
        'reports.read','reports.create','devices.register',
        'formulations.read','formulations.create','formulations.update'
      ] : role == 'quality_manager' ? [
        'org.read','users.read',
        'samples.read','samples.create','samples.update',
        'lab_results.read','lab_results.create','lab_results.update',
        'qc.read','qc.write','qc.approve','qc.reject',
        'reports.read','reports.create','reports.export','devices.register','audit.read',
        'formulations.read'
      ] : role == 'lab' ? [
        'org.read',
        'samples.read','samples.create','samples.update',
        'lab_results.read','lab_results.create','lab_results.update',
        'reports.read','devices.register','formulations.read'
      ] : role == 'viewer' ? [
        'org.read','samples.read','lab_results.read','qc.read','reports.read','devices.register',
        'formulations.read'
      ] : role == 'nutritionist' ? [
        'org.read','samples.read','lab_results.read','reports.read','devices.register',
        'formulations.read','formulations.create','formulations.update'
      ] : [];
    }

    function inOrg(orgId) {
      return myOrg() == orgId;
    }

    // An `invited`/`disabled` member can read nothing and write nothing: the
    // whole permission check is gated on the status, not only on the role.
    //
    // Trial-expiry gate: a `suspended` organization (30-day trial finished,
    // waiting for manual activation by support) locks every member out of all
    // reads and writes below, even though the member row itself is `active`.
    // The owner can still `get` the org document itself (see below) so the
    // app can show the trial-expired screen. Status flips
    // (`trial` → `suspended` → `active`) happen only through the Admin SDK
    // (scheduled cron / manual activation), which bypasses these rules; no
    // client may change any lifecycle field.
    function orgUsable(orgId) {
      let org = get(/databases/$(database)/documents/organizations/$(orgId));
      return org != null && org.data.status in ['trial', 'active'];
    }

    function activeInOrg(orgId) {
      return inOrg(orgId) && myStatus() == 'active' && orgUsable(orgId);
    }

    function can(orgId, perm) {
      let roles = myRoles();
      return activeInOrg(orgId)
        && validRoleSet(roles, myRole())
        && (
        ('admin' in roles && perm in rolePermissions('admin'))
        || ('trial_owner' in roles && perm in rolePermissions('trial_owner'))
        || ('quality_manager' in roles && perm in rolePermissions('quality_manager'))
        || ('lab' in roles && perm in rolePermissions('lab'))
        || ('nutritionist' in roles && perm in rolePermissions('nutritionist'))
        || ('viewer' in roles && perm in rolePermissions('viewer')));
    }

    function canManage(uid) {
      return userDoc(uid) != null
        && can(userDoc(uid).data.organizationId, 'users.update');
    }

    function blocksNewCompany(uid) {
      return userDoc(uid) != null
        && userDoc(uid).data.keys().hasAll(['organizationId'])
        && userDoc(uid).data.status in ['invited','pending_activation','active'];
    }

    // Audit actions the clients may ever write. Anything else (e.g. a forged
    // `MEMBER_ACTIVATED`) is rejected: the log is append-only *and*
    // allow-listed, otherwise any active member could fake an activation entry.
    function validAuditAction(action) {
      return action in [
        'ORGANIZATION_CREATED','ORG_UPDATED',
        'MEMBER_INVITED','MEMBER_INVITE_RESENT','MEMBER_ROLE_CHANGED',
        'MEMBER_ACTIVATED','MEMBER_DISABLED','MEMBER_REMOVED','MEMBER_LEFT',
        'INVITE_CLAIMED',
        'DENIED_ENTRY',
        'SAMPLE_CREATED','SAMPLE_UPDATED','SAMPLE_DELETED',
        'QC_APPROVED','QC_REJECTED',
        'LAB_RESULT_SAVED','SYNC_CONFLICT','BACKUP_RESTORED',
        'SETTINGS_UPDATED','DEVICE_REGISTERED',
        'CUSTOM_TABLE_SAVED','CUSTOM_TABLE_DELETED','CUSTOM_ROW_RECORDED','CUSTOM_ROW_DELETED'];
    }

    // ── sync envelope invariants (plan §6.1) ─────────────────────────────
    // Every pushed document carries the envelope. `createdBy`, `createdAt`,
    // `organizationId` and `localId` are immutable after creation, and the
    // version has to increase by exactly one: that is what makes the
    // last-writer-wins + conflict detection of §9.7 verifiable server-side.
    //
    // Two known gaps, deliberately left open rather than half-closed:
    //
    //  * `createdBy` is only asserted to be a string, not to equal
    //    `request.auth.uid`. `buildRemotePayload` fills it from the local
    //    row's `created_by`, so requiring authorship would reject rows first
    //    pushed by a member other than their author. Attribution is not worth
    //    breaking sync for.
    //  * There is no `hasOnly` per collection. The real payload is *every*
    //    column of the backing table (`buildRemotePayload` ignores
    //    `mutableFields`, which is documentation-only), so a member can append
    //    an arbitrary column that `PullWorker` will mirror locally — e.g.
    //    `reportHtml` on a sample. Closing it requires making `mutableFields`
    //    authoritative first, or the allow-lists will reject legitimate
    //    pushes. Tracked as a follow-up, not a rules tweak.
    function activeOwnedDevice(orgId, deviceId) {
      let device = get(/databases/$(database)/documents/organizations/$(orgId)/devices/$(deviceId));
      return deviceId is string && deviceId != '' && device != null
        && device.data.uid == request.auth.uid
        && device.data.get('status', 'active') == 'active';
    }

    function writerDevice(orgId) {
      let id = request.resource.data.get('deviceId', '');
      let device = get(/databases/$(database)/documents/organizations/$(orgId)/devices/$(id));
      return activeOwnedDevice(orgId, id) && device.data.get('readOnly', true) == false;
    }

    function legacyDomainWritesAllowed(orgId) {
      let org = get(/databases/$(database)/documents/organizations/$(orgId));
      return org != null && org.data.get('commandProtocol', {}).get('enabled', false) != true;
    }

    function hasEnvelope(orgId) {
      return legacyDomainWritesAllowed(orgId) && writerDevice(orgId) && request.resource.data.organizationId == orgId
        && request.resource.data.keys().hasAll([
             'organizationId','version','createdAt','updatedAt',
             'updatedBy','createdBy','deviceId','localId'])
        && request.resource.data.version == 1
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdBy is string
        && request.resource.data.localId != null;
    }

    function bumped(orgId) {
      return legacyDomainWritesAllowed(orgId) && writerDevice(orgId) && request.resource.data.version == resource.data.version + 1
        && request.resource.data.organizationId == orgId
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.localId == resource.data.localId
        && request.resource.data.updatedBy == request.auth.uid
        && (resource.data.get('deletedAt', null) == null || request.resource.data.get('deletedAt', null) != null);
    }

    // ── users/{uid} - the authorization source (plan §6) ─────────────────
    match /users/{uid} {

      function userPayloadOk() {
        return request.resource.data.keys().hasOnly([
                 'email','organizationId','role','roles','status','memberId','inviteKey',
                 'displayName','photoUrl','lastSeenAt','lastDeviceId',
                 'createdAt','updatedAt','version','updatedBy'])
            && request.resource.data.email is string
            && request.resource.data.email.lower() == request.auth.token.email.lower()
            && request.resource.data.organizationId is string
            && request.resource.data.organizationId.size() > 3
            && request.resource.data.role in ['admin','quality_manager','lab','nutritionist','viewer','trial_owner']
            && validRoleSet(rolesOf(request.resource.data), request.resource.data.role)
            && request.resource.data.status in ['invited','pending_activation','active']
            && request.resource.data.version == 1;
      }

      function memberAfterMatchesProfile() {
        let member = getAfter(/databases/$(database)/documents/organizations/
          $(resource.data.organizationId)/members/$(resource.data.memberId));
        return member != null
          && member.data.uid == uid
          && member.data.role == request.resource.data.role
          && rolesMatch(member.data, request.resource.data)
          && member.data.status == request.resource.data.status;
      }

      // (a) claimed invitation: the invite document decides the organization,
      // the role and the member id - the client cannot choose them. The member
      // signed in (password or Google) and now waits for manager activation,
      // so the profile lands in `pending_activation`, never `active`.
      function claimedInvite() {
        let orgId = request.resource.data.organizationId;
        let invite = get(/databases/$(database)/documents/organizations/$(orgId)
                          /invites/$(request.resource.data.inviteKey));
        return request.resource.data.status == 'pending_activation'
          && invite != null
          && invite.data.email.lower() == request.auth.token.email.lower()
          && invite.data.role == request.resource.data.role
          && rolesMatch(invite.data, request.resource.data)
          && invite.data.memberId == request.resource.data.memberId;
      }

      // (b) organization founder: the only way to become `active` is to own an
      // organization that already exists and lists this uid as `ownerUid`.
      // `get()` returns null for a missing document, so a self-declared
      // organization that does not exist yet fails here. A trial company
      // (`status == 'trial'`) yields `trial_owner`; a full company yields
      // `admin`. A later approval action promotes trial → active / owner.
      function foundedOrganization() {
        let orgId = request.resource.data.organizationId;
        let org = get(/databases/$(database)/documents/organizations/$(orgId));
        return request.resource.data.status == 'active'
          && org != null
          && org.data.ownerUid == request.auth.uid
              && ((org.data.status == 'trial'
                && request.resource.data.role == 'trial_owner'
                && rolesOf(request.resource.data) == ['trial_owner'])
              || (org.data.status == 'active'
                && request.resource.data.role == 'admin'
                && rolesOf(request.resource.data) == ['admin']));
      }

      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn() && request.auth.uid == uid
        && verifiedEmail()
        && userPayloadOk()
        && (claimedInvite() || foundedOrganization());
      allow update: if signedIn() && (
            (request.auth.uid == uid
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['displayName','photoUrl','lastSeenAt','lastDeviceId'])
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasAny(['displayName','photoUrl','lastSeenAt','lastDeviceId'])
              && request.resource.data.organizationId == resource.data.organizationId
              && request.resource.data.role == resource.data.role
              && rolesMatch(request.resource.data, resource.data)
              && request.resource.data.status == resource.data.status
              && request.resource.data.memberId == resource.data.memberId
              && request.resource.data.email == resource.data.email)
          || (canManage(uid)
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                    'role','roles','status','displayName','activatedAt','activatedBy',
                    'organizationId','updatedBy','updatedAt','version'])
               && request.resource.data.email == resource.data.email
               && request.resource.data.memberId == resource.data.memberId
               && validRoleSet(rolesOf(request.resource.data), request.resource.data.role)
               && memberAfterMatchesProfile()
               && request.resource.data.version == resource.data.version + 1
               // Activation only moves invited/pending_activation → active, and
               // only the manager path (users.update) may do it: the self
               // branch below can only ever go to `disabled`.
               && (request.resource.data.status == resource.data.status
                   || (resource.data.status in ['invited','pending_activation']
                       && request.resource.data.status == 'active'))
               // The organization binding may only be dropped (disabling a
               // member), never swapped for another organization.
               && (!request.resource.data.keys().hasAll(['organizationId'])
                     || request.resource.data.organizationId == resource.data.organizationId))
          || ( // Manager disable: an active/pending/invited profile moves to
               // `disabled` and drops the organization binding so the account
               // returns to `no_company`. Gated on `users.disable` (not the
               // `canManage`/users.update gate above), same tombstone shape
               // as the self-leave branch.
               can(userDoc(uid).data.organizationId, 'users.disable')
               && resource.data.status in ['invited','pending_activation','active']
               && request.resource.data.status == 'disabled'
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                    'role','roles','status','displayName','activatedAt','activatedBy',
                    'organizationId','memberId','updatedBy','updatedAt','version'])
               && request.resource.data.email == resource.data.email
               && request.resource.data.role == resource.data.role
               && rolesMatch(request.resource.data, resource.data)
               && !request.resource.data.keys().hasAll(['organizationId'])
               && !request.resource.data.keys().hasAll(['memberId'])
               && request.resource.data.version == resource.data.version + 1)
          || ( // Self-service departure: the member drops their own organization
               // binding. `organizationId` may only disappear, never change.
               request.auth.uid == uid
               && resource.data.status in ['invited','pending_activation','active']
               && request.resource.data.status == 'disabled'
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                    'status','organizationId','memberId','updatedBy','updatedAt','version'])
               && !request.resource.data.keys().hasAll(['organizationId'])
               && !request.resource.data.keys().hasAll(['memberId'])
               && request.resource.data.role == resource.data.role
               && rolesMatch(request.resource.data, resource.data)
               && request.resource.data.email == resource.data.email
               && request.resource.data.updatedBy == request.auth.uid
               && request.resource.data.version == resource.data.version + 1));
      allow delete: if false;
    }

    // ── organizations ────────────────────────────────────────────────────
    match /organizations/{orgId} {

      // The organization id is derived from the owner uid, so creation is
      // idempotent; a second attempt hits `update` (owner-only) or is denied.
      // `activeInOrg`: an invited/pending/disabled member reads nothing, and a
      // member of a `suspended` company reads nothing below the org document.
      // Single-company policy (§2): a bound account
      // (invited/pending_activation/active) cannot create a second company —
      //sign-out alone never unblocks this, only leaving does. New companies
      // start as `trial` with a one-time 30-day window (`trialStartedAt`,
      // `trialEndsAt`); expiry flips them to `suspended` via the server cron
      // and manual activation by support (`manuallyActivated=true`) is
      // permanent and never auto-suspended again.
      //
      // The owner may always `get` the org document itself — even when
      // suspended — so the app can render the trial-expired + support screen.
      // A profile-bound member may also `get` the document, but only while the
      // company is `suspended`: a fresh login after expiry must still see the
      // suspension (the client gate reads this document). Members of usable
      // companies keep the previous behavior (`activeInOrg` or nothing), so an
      // invited/pending member still reads nothing.
      // Everything below the org document stays locked by `activeInOrg`.
      allow get: if activeInOrg(orgId)
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || (signedIn() && hasProfile() && myOrg() == orgId
            && resource.data.status == 'suspended');
      allow list: if false;
      allow create: if signedIn()
        && verifiedEmail()
        && !exists(/databases/$(database)/documents/organizations/$(orgId))
        && !blocksNewCompany(request.auth.uid)
        && request.resource.data.keys().hasOnly([
             'name','ownerUid','status','createdAt','createdBy','schemaVersion',
             'updatedBy','updatedAt','version',
             'trialStartedAt','trialEndsAt','trialConsumed','manuallyActivated'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'trial'
        && request.resource.data.trialConsumed == false
        && request.resource.data.manuallyActivated == false
        && request.resource.data.version == 1;
      // No client may change the organization lifecycle: `status`,
      // `trialStartedAt`, `trialEndsAt`, `trialConsumed` and
      // `manuallyActivated` are pinned. `trial` → `suspended` (server cron)
      // and `suspended` → `active` (manual activation by support) run through
      // the Admin SDK, which bypasses these rules. An active admin of a usable
      // org may still rename it or bump the schema version.
      allow update: if can(orgId, 'org.update')
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.status == resource.data.status
        && request.resource.data.get('trialStartedAt', null) == resource.data.get('trialStartedAt', null)
        && request.resource.data.get('trialEndsAt', null) == resource.data.get('trialEndsAt', null)
        && request.resource.data.get('trialConsumed', false) == resource.data.get('trialConsumed', false)
        && request.resource.data.get('manuallyActivated', false) == resource.data.get('manuallyActivated', false)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name','schemaVersion','updatedBy','updatedAt','version']);
      allow delete: if false;

      // Heartbeat written by the sync engine.
      match /meta/{docId} {
        allow get: if inOrg(orgId);
        allow list: if false;
        allow create: if activeInOrg(orgId)
          && request.resource.data.keys().hasOnly([
               'lastWriteAt','lastWriteBy','lastEntity','version'])
          && request.resource.data.lastWriteBy == request.auth.uid;
        allow update: if activeInOrg(orgId)
          && request.resource.data.keys().hasOnly([
               'lastWriteAt','lastWriteBy','lastEntity','version'])
          && request.resource.data.lastWriteBy == request.auth.uid;
        allow delete: if false;
      }

      // Invitations are readable by the invited e-mail only; the admin sees
      // them through `list`.
      //
      // The document id is `inviteKey(email)` (derived, guessable), but the
      // `get` gate still checks the *stored* e-mail against the token e-mail,
      // and the org id itself (`org_…`) is unguessable — so enumerating
      // another org's roster would need both its org id and a matching token
      // e-mail. Cross-org reads stay denied (emulator: invite confidentiality).
      // Admins of the owning org are also allowed, to resolve one by key.
      match /invites/{inviteKey} {
        allow get: if can(orgId, 'users.read')
          || (verifiedEmail()
              && resource.data.email is string
              && resource.data.email.lower() == request.auth.token.email.lower());
        allow list: if can(orgId, 'users.read');
        allow create: if can(orgId, 'users.create')
          && request.resource.data.keys().hasOnly([
               'email','role','roles','memberId','status','invitedBy','invitedByName',
               'createdAt','updatedAt','version'])
          && request.resource.data.email is string
          && request.resource.data.email.size() > 3
          && request.resource.data.email == request.resource.data.email.lower()
          && request.resource.data.role in ['admin','quality_manager','lab','nutritionist','viewer','trial_owner']
          && request.resource.data.role != 'trial_owner'
          && validRoleSet(rolesOf(request.resource.data), request.resource.data.role)
          && request.resource.data.status == 'invited'
          && request.resource.data.memberId is string
          && request.resource.data.memberId.size() > 6
          && request.resource.data.version == 1;
        // Claiming an invite (claimedBy/claimedAt) or refreshing the invite.
        allow update: if (verifiedEmail()
                           && resource.data.email.lower() == request.auth.token.email.lower()
                           && request.resource.data.diff(resource.data).affectedKeys()
                                .hasOnly(['claimedBy','claimedAt','updatedAt','version'])
                           && request.resource.data.email == resource.data.email
                           && request.resource.data.role == resource.data.role
                           && request.resource.data.memberId == resource.data.memberId)
                       || (can(orgId, 'users.create')
                           && request.resource.data.diff(resource.data).affectedKeys()
                                .hasOnly(['role','roles','status','version','updatedBy','updatedAt'])
                           && request.resource.data.email == resource.data.email
                           && request.resource.data.memberId == resource.data.memberId
                           && validRoleSet(rolesOf(request.resource.data), request.resource.data.role));
        allow delete: if can(orgId, 'users.update');
      }

      match /members/{memberId} {

        function memberKeysOk() {
          return request.resource.data.keys().hasAll([
                   'uid','email','role','status','version','updatedBy','updatedAt','createdAt'])
              && request.resource.data.email is string
              && request.resource.data.role in ['admin','quality_manager','lab','nutritionist','viewer','trial_owner']
              && validRoleSet(rolesOf(request.resource.data), request.resource.data.role)
              && request.resource.data.status in ['invited','pending_activation','active','disabled']
              && request.resource.data.version == 1;
        }

        function profileDocumentMatchesMember(memberUid) {
          let profile = getAfter(/databases/$(database)/documents/users/$(memberUid));
          return profile != null
            && profile.data.memberId == memberId
            && profile.data.role == request.resource.data.role
            && rolesMatch(profile.data, request.resource.data)
            && profile.data.status == request.resource.data.status;
        }

        function profileAfterMatchesMember() {
          let memberUid = resource.data.uid;
          return memberUid == '' || memberUid == null
            || profileDocumentMatchesMember(memberUid);
        }

        // Admin inviting a member: the member document may only be created in
        // the `invited` state - an admin cannot mint an active member.
        function invitedByAdmin() {
          return can(orgId, 'users.create') && memberKeysOk()
            && request.resource.data.role != 'trial_owner'
            && request.resource.data.status == 'invited';
        }

        // Organization founder writing its own member document: an active
        // `admin` for a full company, an active `trial_owner` for a trial.
        function founderMember() {
          let org = get(/databases/$(database)/documents/organizations/$(orgId));
          return request.resource.data.uid == request.auth.uid
            && request.resource.data.status == 'active'
            && org != null
            && org.data.ownerUid == request.auth.uid
                  && ((org.data.status == 'trial'
                  && request.resource.data.role == 'trial_owner'
                  && rolesOf(request.resource.data) == ['trial_owner'])
                || (org.data.status == 'active'
                  && request.resource.data.role == 'admin'
                  && rolesOf(request.resource.data) == ['admin']));
        }

        allow get, list: if activeInOrg(orgId);
        allow create: if invitedByAdmin() || founderMember();
        allow update: if (
              // Manager activation (plan §6): role / status / activation audit
              // only, version bumps by exactly one in the same batch as
              // `users/{uid}`. Activation only moves invited/pending → active;
              // a member can never activate itself (see the claim branch: it
              // cannot touch `status` at all). Refreshing an invite
              // (resend: version/updated bump while `invited`) is also here.
              can(orgId, 'users.update')
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                   'role','roles','status','displayName','activatedAt','activatedBy',
                   'updatedBy','updatedAt','version','deletedAt',
                   'invitedBy','invitedByName','invitedAt'])
              && request.resource.data.email == resource.data.email
              && validRoleSet(rolesOf(request.resource.data), request.resource.data.role)
              && profileAfterMatchesMember()
              && request.resource.data.version == resource.data.version + 1
              && (request.resource.data.status == resource.data.status
                  || (resource.data.status in ['invited','pending_activation']
                      && request.resource.data.status == 'active'))
            ) || (
              // Manager disable/remove (tombstone, never delete): an
              // `invited`/`pending_activation`/`active` row moves to
              // `disabled`. Gated on `users.disable`, never on `users.update`,
              // so a role with only `users.update` cannot revoke access.
              can(orgId, 'users.disable')
              && resource.data.status in ['invited','pending_activation','active']
              && request.resource.data.status == 'disabled'
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status','deletedAt','updatedBy','updatedAt','version'])
              && request.resource.data.uid == resource.data.uid
              && request.resource.data.role == resource.data.role
              && rolesMatch(request.resource.data, resource.data)
              && request.resource.data.email == resource.data.email
              && request.resource.data.updatedBy == request.auth.uid
              && request.resource.data.version == resource.data.version + 1)
            || (
              // Invitee claiming their own member document: binds the uid, the
              // status moves invited → pending_activation (waiting for manager
              // activation) and nothing else changes.
              verifiedEmail()
              && resource.data.status == 'invited'
              && resource.data.email is string
              && resource.data.email.lower() == request.auth.token.email.lower()
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['uid','roles','status','updatedBy','updatedAt','version'])
              && request.resource.data.status == 'pending_activation'
              && request.resource.data.role == resource.data.role
              && validRoleSet(rolesOf(request.resource.data), request.resource.data.role)
              && rolesMatch(request.resource.data, resource.data)
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.updatedBy == request.auth.uid
              // Same envelope invariant as every other write: exactly one step.
              && request.resource.data.version == resource.data.version + 1)
            || (
              // Self-service departure: a member leaving on their own. Any role
              // may do this, which is why it is not gated on `users.update`.
              // It can only ever move the row to `disabled` — never change the
              // role, the e-mail or the member id, so leaving can never be used
              // to escalate.
              verifiedEmail()
              && resource.data.status in ['invited','pending_activation','active']
              && resource.data.uid == request.auth.uid
              && request.resource.data.status == 'disabled'
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status','deletedAt','updatedBy','updatedAt','version'])
              && request.resource.data.uid == resource.data.uid
              && request.resource.data.role == resource.data.role
              && rolesMatch(request.resource.data, resource.data)
              && request.resource.data.email == resource.data.email
              && request.resource.data.updatedBy == request.auth.uid
              && request.resource.data.version == resource.data.version + 1);
        // Disabling is a status change (tombstone), never a delete.
        allow delete: if false;
      }

      // ── synced domain documents (plan §6.1) ───────────────────────────
      match /parameters/{docId} {
        allow read: if can(orgId, 'samples.read');
        allow create: if can(orgId, 'lab_results.create') && hasEnvelope(orgId);
        allow update: if can(orgId, 'lab_results.update') && bumped(orgId);
        allow delete: if false;
      }
      match /materialBounds/{docId} {
        allow read: if can(orgId, 'samples.read');
        allow create: if can(orgId, 'lab_results.create') && hasEnvelope(orgId);
        allow update: if can(orgId, 'lab_results.update') && bumped(orgId);
        allow delete: if false;
      }
      match /organizationSettings/{docId} {
        function sharedKey() {
          return request.resource.data.key in [
            'department_label','report_logo_data_uri','qa_form_no',
            'inspection_report_form_no','inspection_label_form_no',
            'equipment_label_form_no','daily_report_form_no','monthly_report_form_no',
            'yearly_report_form_no','followup_report_form_no','lab_daily_report_form_no',
            'lab_monthly_report_form_no','lab_yearly_report_form_no','ncr_report_form_no'];
        }
        allow read: if can(orgId, 'reports.read');
        allow create: if can(orgId, 'reports.create') && hasEnvelope(orgId)
          && sharedKey() && request.resource.data.value is string;
        allow update: if can(orgId, 'reports.create') && bumped(orgId)
          && sharedKey() && request.resource.data.key == resource.data.key
          && request.resource.data.value is string;
        allow delete: if false;
      }
      match /qcSops/{docId} {
        allow read: if can(orgId, 'qc.read');
        allow create: if can(orgId, 'qc.write') && hasEnvelope(orgId)
          && (!(request.resource.data.status in ['Approved','Published']) || can(orgId, 'qc.approve'));
        allow update: if can(orgId, 'qc.write') && bumped(orgId)
          && (request.resource.data.status == resource.data.status
              || !(request.resource.data.status in ['Approved','Published'])
              || can(orgId, 'qc.approve'));
        allow delete: if false;
      }
      match /qcSopRevisions/{docId} {
        allow read: if can(orgId, 'qc.read');
        allow create: if can(orgId, 'qc.approve') && hasEnvelope(orgId);
        allow update: if can(orgId, 'qc.approve') && bumped(orgId);
        allow delete: if false;
      }
      match /qcSopReads/{docId} {
        allow read: if can(orgId, 'qc.read');
        allow create: if can(orgId, 'qc.write') && hasEnvelope(orgId);
        allow update: if can(orgId, 'qc.write') && bumped(orgId);
        allow delete: if false;
      }

      match /samples/{docId} {
        allow read: if can(orgId, 'samples.read');
        allow create: if can(orgId, 'samples.create') && hasEnvelope(orgId);
        allow update: if can(orgId, 'samples.update') && bumped(orgId);
        allow delete: if false; // tombstone only (`deletedAt`)
      }

      // Append-only decision log.
      //
      // `newStatus` is constrained to the four decision codes the app writes
      // (`lib/core/domain/rules.dart` `decisionCodes`). Previously any string
      // other than `'approved'` was accepted under `qc.reject`, so a member
      // could write a bogus/near-miss decision state into the ledger. Approvals
      // require `qc.approve`, rejections require `qc.reject`.
      match /qualityChecks/{docId} {
        allow read: if can(orgId, 'qc.read');
        allow create: if hasEnvelope(orgId)
          && request.resource.data.newStatus in [
               'APPROVED','CONDITIONAL_APPROVAL','PARTIAL_REJECTION','FULL_REJECTION']
          && ((request.resource.data.newStatus in ['APPROVED','CONDITIONAL_APPROVAL']
                 && can(orgId, 'qc.approve'))
              || (request.resource.data.newStatus in ['PARTIAL_REJECTION','FULL_REJECTION']
                 && can(orgId, 'qc.reject')));
        allow update: if false;
        allow delete: if false;
      }

      match /labResults/{docId} {
        allow read: if can(orgId, 'lab_results.read');
        allow create: if can(orgId, 'lab_results.create') && hasEnvelope(orgId);
        allow update: if can(orgId, 'lab_results.update') && bumped(orgId);
        allow delete: if false;
      }

      match /labConfig/{docId} {
        allow read: if resource.data.configType.matches('nutrition_.*')
          ? can(orgId, 'formulations.read') : can(orgId, 'samples.read');
        allow create: if (request.resource.data.configType.matches('nutrition_.*')
          ? can(orgId, 'formulations.create') : can(orgId, 'lab_results.create'))
          && hasEnvelope(orgId);
        allow update: if (request.resource.data.configType.matches('nutrition_.*')
          ? can(orgId, 'formulations.update') : can(orgId, 'lab_results.update'))
          && request.resource.data.configType == resource.data.configType
          && bumped(orgId);
        allow delete: if false;
      }

      // Comprehensive sync (plan §7): inventory / ledger / equipment /
      // worksheets / reference. Same envelope + version-bump contract as
      // the core collections; append-only ledgers reject update/delete.
      match /inventoryItems/{docId} {
        allow read: if can(orgId, 'lab_results.read');
        allow create: if can(orgId, 'lab_results.create') && hasEnvelope(orgId);
        allow update: if can(orgId, 'lab_results.update') && bumped(orgId);
        allow delete: if false;
      }

      match /inventoryTransactions/{docId} {
        allow read: if can(orgId, 'lab_results.read');
        allow create: if can(orgId, 'lab_results.create') && hasEnvelope(orgId);
        allow update: if false;
        allow delete: if false;
      }

      match /inventoryLots/{docId} {
        allow read: if can(orgId, 'lab_results.read');
        allow create: if can(orgId, 'lab_results.create') && hasEnvelope(orgId);
        allow update: if can(orgId, 'lab_results.update') && bumped(orgId);
        allow delete: if false;
      }

      match /consumption/{docId} {
        allow read: if can(orgId, 'lab_results.read');
        allow create: if can(orgId, 'lab_results.create') && hasEnvelope(orgId);
        allow update: if false;
        allow delete: if false;
      }

      match /stockAdjustments/{docId} {
        allow read: if can(orgId, 'lab_results.read');
        allow create: if can(orgId, 'lab_results.create') && hasEnvelope(orgId);
        allow update: if false;
        allow delete: if false;
      }

      match /equipment/{docId} {
        allow read: if can(orgId, 'lab_results.read');
        allow create: if can(orgId, 'lab_results.create') && hasEnvelope(orgId);
        allow update: if can(orgId, 'lab_results.update') && bumped(orgId);
        allow delete: if false;
      }

      match /equipmentEvents/{docId} {
        allow read: if can(orgId, 'lab_results.read');
        allow create: if can(orgId, 'lab_results.create') && hasEnvelope(orgId);
        allow update: if can(orgId, 'lab_results.update') && bumped(orgId);
        allow delete: if false;
      }

      match /worksheets/{docId} {
        allow read: if can(orgId, 'lab_results.read');
        allow create: if can(orgId, 'lab_results.create') && hasEnvelope(orgId);
        allow update: if can(orgId, 'lab_results.update') && bumped(orgId);
        allow delete: if false;
      }

      match /referenceMaterials/{docId} {
        allow read: if can(orgId, 'samples.read');
        allow create: if can(orgId, 'lab_results.create') && hasEnvelope(orgId);
        allow update: if can(orgId, 'lab_results.update') && bumped(orgId);
        allow delete: if false;
      }

      // Product batch samples (محضر التشغيلة rows): source data only.
      // Same envelope + version-bump contract as labResults; derived
      // artifacts (PDF/HTML) are never stored here — rebuilt on-device.
      match /productBatchSamples/{docId} {
        allow read: if can(orgId, 'lab_results.read');
        allow create: if can(orgId, 'lab_results.create') && hasEnvelope(orgId);
        allow update: if can(orgId, 'lab_results.update') && bumped(orgId);
        allow delete: if false;
      }

      // QC user-authored tables (the QC settings feature): definition,
      // typed columns, records. Same envelope + version-bump contract;
      // children carry the parent's remote id so the pull remaps the
      // per-device `table_id`. Deletes stay tombstone-only.
      match /qcCustomTables/{docId} {
        allow read: if can(orgId, 'qc.read');
        allow create: if can(orgId, 'qc.write') && hasEnvelope(orgId);
        allow update: if can(orgId, 'qc.write') && bumped(orgId);
        allow delete: if false;
      }

      match /qcCustomTableFields/{docId} {
        allow read: if can(orgId, 'qc.read');
        allow create: if can(orgId, 'qc.write') && hasEnvelope(orgId);
        allow update: if can(orgId, 'qc.write') && bumped(orgId);
        allow delete: if false;
      }

      match /qcCustomTableRows/{docId} {
        allow read: if can(orgId, 'qc.read');
        allow create: if can(orgId, 'qc.write') && hasEnvelope(orgId);
        allow update: if can(orgId, 'qc.write') && bumped(orgId);
        allow delete: if false;
      }

      // QC checklists and their execution + the NCR/CAPA pipeline (plan P8).
      // Same envelope + tombstone-only delete contract as the QC custom
      // tables; children carry the parent's remote id (`template_remote_id`,
      // `inspection_remote_id`, ...) so the pull remaps the per-device
      // autoincrement foreign keys.
      match /qcTemplates/{docId} {
        allow read: if can(orgId, 'qc.read');
        allow create: if can(orgId, 'qc.write') && hasEnvelope(orgId);
        allow update: if can(orgId, 'qc.write') && bumped(orgId);
        allow delete: if false;
      }

      match /qcSections/{docId} {
        allow read: if can(orgId, 'qc.read');
        allow create: if can(orgId, 'qc.write') && hasEnvelope(orgId);
        allow update: if can(orgId, 'qc.write') && bumped(orgId);
        allow delete: if false;
      }

      match /qcItems/{docId} {
        allow read: if can(orgId, 'qc.read');
        allow create: if can(orgId, 'qc.write') && hasEnvelope(orgId);
        allow update: if can(orgId, 'qc.write') && bumped(orgId);
        allow delete: if false;
      }

      match /qcInspections/{docId} {
        allow read: if can(orgId, 'qc.read');
        allow create: if can(orgId, 'qc.write') && hasEnvelope(orgId);
        allow update: if can(orgId, 'qc.write') && bumped(orgId);
        allow delete: if false;
      }

      match /qcResponses/{docId} {
        allow read: if can(orgId, 'qc.read');
        allow create: if can(orgId, 'qc.write') && hasEnvelope(orgId);
        allow update: if can(orgId, 'qc.write') && bumped(orgId);
        allow delete: if false;
      }

      // Every press of the per-task "done" button appends one row: there is
      // no edit path, so the collection is append-only.
      match /qcTaskLogs/{docId} {
        allow read: if can(orgId, 'qc.read');
        allow create: if can(orgId, 'qc.write') && hasEnvelope(orgId);
        allow update: if false;
        allow delete: if false;
      }

      match /qcFindingsNc/{docId} {
        allow read: if can(orgId, 'qc.read');
        allow create: if can(orgId, 'qc.write') && hasEnvelope(orgId);
        allow update: if can(orgId, 'qc.write') && bumped(orgId);
        allow delete: if false;
      }

      match /qcCapa/{docId} {
        allow read: if can(orgId, 'qc.read');
        allow create: if can(orgId, 'qc.write') && hasEnvelope(orgId);
        allow update: if can(orgId, 'qc.write') && bumped(orgId);
        allow delete: if false;
      }

      // Push tokens are private per-device infrastructure. Read-only viewers
      // may register their own token; tokens never grant domain permissions.
      match /pushTokens/{tokenId} {
        function tokenShapeOk() {
          return request.resource.data.keys().hasOnly([
            'uid','deviceId','token','platform','updatedAt'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.token is string
            && request.resource.data.token.size() > 0
            && request.resource.data.token.size() <= 4096
            && request.resource.data.deviceId is string
            && request.resource.data.platform in ['android','ios']
            && request.resource.data.updatedAt is string;
        }
        function ownsPushDevice() {
          let device = get(/databases/$(database)/documents/organizations/$(orgId)/devices/$(request.resource.data.deviceId));
          return device != null && device.data.uid == request.auth.uid
            && device.data.get('status', 'active') != 'revoked';
        }
        allow read: if false;
        allow create: if activeInOrg(orgId) && tokenShapeOk() && ownsPushDevice();
        allow update: if activeInOrg(orgId) && tokenShapeOk() && ownsPushDevice()
          && resource.data.uid == request.auth.uid
          && request.resource.data.deviceId == resource.data.deviceId;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }

      // Device inventory: a member may only write its own document, admins may
      // refresh or revoke any of them.
      match /devices/{deviceId} {
        // The exact field set `DeviceRegistry` can ever write. `revokedAt` /
        // `revokedReason` / `status` come from `revoke()`; the rest from
        // `register()` and the `lastSeenAt` heartbeat. Writes are merge-sets,
        // so this is the union of every partial payload.
        function deviceKeysOk() {
          return request.resource.data.keys().hasOnly([
            'uid','email','displayName','platform','role','readOnly',
            'lastSeenAt','status','revokedAt','revokedReason','version']);
        }

        // `activeInOrg`, not `inOrg`: an invited/disabled member must not be
        // able to list every member's uid, e-mail, platform and role.
        // `list` needs `devices.read` (admins); `get` additionally allows the
        // owner to read their own document (heartbeat/register needs it).
        allow get: if can(orgId, 'devices.read')
          || (activeInOrg(orgId)
              && resource.data.uid == request.auth.uid);
        allow list: if can(orgId, 'devices.read');
        allow create: if activeInOrg(orgId)
          && can(orgId, 'devices.register')
          && deviceKeysOk()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.version == 1;
        // Ownership is checked against the **stored** document. Checking
        // `request.resource.data.uid` instead (as this used to) meant any
        // member could write their own uid into anybody's device document, and
        // with no `hasOnly` they could then set arbitrary fields on it.
        //
        // The admin branch additionally may not re-assign ownership: `revoke()`
        // blanks the uid (it acts on a device it did not create), and nothing
        // legitimately changes it.
        allow update: if activeInOrg(orgId) && ((resource.data.uid == request.auth.uid
                          && request.resource.data.uid == resource.data.uid
                          && deviceKeysOk()
                          && request.resource.data.get('readOnly', true) == resource.data.get('readOnly', true)
                          // Owner heartbeat/register must never change the
                          // revocation state: self sign-out goes through the
                          // same branch but only `active → revoked`, never
                          // `revoked → active` (no self un-revoke).
                          && (request.resource.data.get('status', 'active')
                                == resource.data.get('status', 'active')
                              || (resource.data.get('status', 'active') == 'active'
                                  && request.resource.data.get('status', 'active') == 'revoked')))
                      || (can(orgId, 'devices.update')
                          && deviceKeysOk()
                          && request.resource.data.uid in [resource.data.uid, '']
                          // Admins may revoke but never un-revoke either.
                          && (request.resource.data.get('status', 'active')
                                == resource.data.get('status', 'active')
                              || (resource.data.get('status', 'active') != 'revoked'
                                  && request.resource.data.get('status', 'active') == 'revoked'))));
        allow delete: if false;
      }

      // A private append acknowledgement is part of the same transaction as
      // its business record. It exposes hashes, never laboratory values.
      match /syncReceipts/{uid}/entries/{receiptId} {
        allow get: if activeInOrg(orgId) && request.auth.uid == uid;
        allow list: if false;
        allow create: if activeInOrg(orgId) && request.auth.uid == uid
          && activeOwnedDevice(orgId, request.resource.data.get('deviceId', ''))
          && request.resource.data.keys().hasOnly([
            'fingerprint','deviceId','collectionId','documentId','version','createdAt'])
          && receiptId.matches('^[a-f0-9]{64}$')
          && request.resource.data.fingerprint is string
          && request.resource.data.fingerprint.matches('^[a-f0-9]{64}$')
          && request.resource.data.collectionId in [
            'qualityChecks','inventoryTransactions','consumption','stockAdjustments','qcTaskLogs','auditLogs']
          && request.resource.data.documentId is string
          && request.resource.data.documentId.size() > 0
          && request.resource.data.version == 1
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }

      match /auditLogs/{docId} {
        allow read: if can(orgId, 'audit.read');
        allow create: if activeInOrg(orgId)
          && activeOwnedDevice(orgId, request.resource.data.get('deviceId', ''))
          && request.resource.data.keys().hasOnly([
               'userId','userName','organizationId','action','entityType','entityId',
               'detailsJson','deviceId','occurredAt','version'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.organizationId == orgId
          && request.resource.data.action is string
          && validAuditAction(request.resource.data.action)
          && request.resource.data.version == 1;
        allow update, delete: if false; // append-only
      }

      // ── Central command protocol (plan 2026-10-25 §6/§9) ────────────────
      // After cutover, clients NEVER write business records directly: the
      // command service writes them. These store collections are written
      // only by the Admin SDK (bypassing rules); clients read only what
      // review/accounting requires.
      //
      // Note (§11, stage 9): this does not yet CLOSE the old direct-write
      // path above — the migration order is "block the old writes first" at
      // cutover. The rules below are the new stores' contract.
      match /commandReceipts/{operationId} {
        // Receipt recovery after "resend the same request": the same actor
        // may read its own receipts; hashes live here, no lab data.
        allow get: if activeInOrg(orgId)
          && resource.data.uid == request.auth.uid;
        allow list: if activeInOrg(orgId) && can(orgId, 'audit.read');
        allow create, update, delete: if false;
      }
      match /changeEvents/{eventId} {
        // Unified reading (§8): members read the change feed for their own
        // organization; every write belongs to the command service.
        allow read: if can(orgId, 'samples.read') && resource.data.entityType == 'sample';
        allow create, update, delete: if false;
      }
      match /counters/{counterId} {
        // Server-shared sequence counters — this is THE identity data
        // (official numbers); clients read nothing, write nothing.
        allow read, write: if false;
      }
      match /notifyRequests/{requestId} {
        // Notification fan-out requests, consumed by the push delivery
        // function after the commit. Not client-readable at all.
        allow read, write: if false;
      }

      // Nothing else inside an organization is writable.
      match /{document=**} { allow read, write: if false; }
    }

    // Catch-all: no collection outside the ones above is reachable.
    match /{document=**} { allow read, write: if false; }
  }
}

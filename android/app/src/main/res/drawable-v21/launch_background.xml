<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy launch splash for API 21+: light field (matches the Flutter launch
     splash), logo centered at ~48% of the screen width. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background_color" />

    <item android:gravity="center">
        <scale
            android:drawable="@drawable/launch_image"
            android:scaleGravity="center"
            android:scaleWidth="48%"
            android:scaleHeight="48%" />
    </item>
</layer-list>

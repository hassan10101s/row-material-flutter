<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy launch splash for API 21+: black base to match the logo, image
     scaled to ~48% and centered (mirrors drawable/launch_background.xml,
     which only applies below API 21). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/black" />

    <item android:gravity="center">
        <scale
            android:drawable="@drawable/launch_image"
            android:scaleGravity="center"
            android:scaleWidth="48%"
            android:scaleHeight="48%" />
    </item>
</layer-list>

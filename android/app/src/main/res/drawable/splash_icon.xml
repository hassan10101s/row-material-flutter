<?xml version="1.0" encoding="utf-8"?>
<!-- Centered icon for the Android 12+ (API 31+) system splash. The OS masks
     the icon into a circle (~192dp diameter centered in this 288dp drawable),
     so the full-bleed logo would have its rings/tails cropped. The logo is
     therefore pre-inset into a 512px transparent square
     (splash_logo_inset.png) sized so its bounding-box diagonal fits inside
     that mask circle. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="288dp"
        android:height="288dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item
        android:width="192dp"
        android:height="192dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/splash_logo_inset" />
    </item>
</layer-list>

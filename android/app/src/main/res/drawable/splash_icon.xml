<?xml version="1.0" encoding="utf-8"?>
<!-- Centered icon for the Android 12+ (API 31+) system splash. The outer
     288dp square is transparent padding; the 192dp bitmap is the artwork the
     OS draws (same layering as the morattab reference: transparent holder
     plus centered launch_image). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="288dp"
        android:height="288dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item
        android:width="192dp"
        android:height="192dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/launch_image" />
    </item>
</layer-list>
